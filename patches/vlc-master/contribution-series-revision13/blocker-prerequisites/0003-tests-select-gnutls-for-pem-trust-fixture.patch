+    bool missing;
+    client_creds = fixture_ClientCreate(obj, &missing);
+    if (missing)
+    {
+        vlc_tls_ServerDelete(server_creds);
+        libvlc_release(vlc);
+        return 77;
+    }
     assert(client_creds != NULL);
 
