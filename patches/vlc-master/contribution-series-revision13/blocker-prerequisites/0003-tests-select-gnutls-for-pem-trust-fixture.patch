+/* The PEM trust fixture below configures the GnuTLS credential backend. */
+static vlc_tls_client_t *fixture_ClientCreate(vlc_object_t *obj, bool *missing)
+{
+    module_t **mods = NULL;
+    ssize_t count = vlc_module_match("tls client", "gnutls", true, &mods, NULL);
+    *missing = count == 0;
+    if (count <= 0)
+    {
+        free(mods);
+        return NULL;
+    }
+
+    int (*probe)(vlc_tls_client_t *) = vlc_module_map(obj->logger, mods[0]);
+    free(mods);
+    if (probe == NULL)
+        return NULL;
+
+    vlc_tls_client_t *client = vlc_object_create(obj, sizeof(*client));
+    if (client == NULL)
+        return NULL;
+    if (probe(client) == VLC_SUCCESS)
+        return client;
+
+    /* GnuTLS OpenClient frees failed initialization resources itself. */
+    vlc_object_delete(client);
+    return NULL;
+}
+
 int main(void)
 {
     libvlc_instance_t *vlc;
@@ -180,7 +208,14 @@ int main(void)
 
     server_creds = vlc_tls_ServerCreate(obj, CERTFILE, NULL);
     assert(server_creds != NULL);
