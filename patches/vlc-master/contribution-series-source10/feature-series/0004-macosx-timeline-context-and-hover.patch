-check-macosx: VLCMacOSXTests.xctest
+# Read real plugin configuration from the normal build tree. Cache generation
+# runs in its own process; XCTest disables plugin scanning to avoid loading a
+# second copy of the Objective-C GUI classes linked into its test bundle.
+# Invoke the built Mach-O directly: macOS SIP purges DYLD_* before the libtool
+# shell wrapper can use the scoped uninstalled library/framework paths.
+macosx-test-plugin-cache: libmacosx_plugin.la
+	$(AM_V_at)$(MAKE) -C $(top_builddir)/bin vlc-cache-gen$(EXEEXT)
+	$(AM_V_at)DYLD_LIBRARY_PATH="$(abs_top_builddir)/src/.libs:$(abs_top_builddir)/lib/.libs" \
+		DYLD_FRAMEWORK_PATH="$(CONTRIB_DIR):$(CONTRIB_DIR)/Frameworks" \
+		"$(abs_top_builddir)/bin/.libs/vlc-cache-gen$(EXEEXT)" "$(abs_builddir)"
+
+$(macosx_gui_xctest_bundles): | macosx-test-plugin-cache
+AM_TESTS_ENVIRONMENT = VLC_PLUGIN_PATH="$(abs_builddir)"; export VLC_PLUGIN_PATH;
+
+check-macosx: $(macosx_gui_xctest_bundles)
+	$(AM_V_at)VLC_PLUGIN_PATH="$(abs_builddir)"; export VLC_PLUGIN_PATH; result=0; for bundle in $(macosx_gui_xctest_bundles); do $(XCTEST_LOG_COMPILER) $$bundle || result=$$?; done; exit $$result
+
+# Focused context seam keeps its injected stubs separate from service tests.
+check_PROGRAMS += VLCTimelineContextTests
+macosx_gui_xctest_bundles += VLCTimelineContextTests.xctest
+VLCTimelineContextTests_SOURCES = \
+	gui/macosx/timeline/VLCTimelineContext.m \
+	gui/macosx/timeline/VLCTimelineContextTests.m \
+	gui/macosx/timeline/VLCTimelineContextTestSupport.m
+VLCTimelineContextTests_CPPFLAGS = $(VLCMacOSXTests_CPPFLAGS)
+VLCTimelineContextTests_OBJCFLAGS = $(VLCMacOSXTests_OBJCFLAGS)
+VLCTimelineContextTests_LDFLAGS = $(VLCMacOSXTests_LDFLAGS)
+VLCTimelineContextTests_LDADD = $(top_builddir)/src/libvlccore.la
+VLCTimelineContextTests_LINK = $(LIBTOOL) $(AM_V_lt) --tag=CC \
+	$(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=link $(OBJCLD) \
+	$(VLCTimelineContextTests_OBJCFLAGS) $(OBJCFLAGS) \
+	$(VLCTimelineContextTests_LDFLAGS) $(LDFLAGS) -o $@
+VLCTimelineContextTests.xctest: VLCTimelineContextTests$(EXEEXT) $(srcdir)/gui/macosx/tests/VLCMacOSXTests-Info.plist
+	$(AM_V_GEN)$(MKDIR_P) $@/Contents/MacOS
