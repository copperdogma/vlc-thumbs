diff --git a/modules/gui/macosx/tests/VLCTimelineHoverReentrancyTest.m b/modules/gui/macosx/tests/VLCTimelineHoverReentrancyTest.m
new file mode 100644
index 0000000000000000000000000000000000000000..f73d8b806d0e3a949e0f5509fa080518ea6630a1
--- /dev/null
+++ b/modules/gui/macosx/tests/VLCTimelineHoverReentrancyTest.m
@@ -0,0 +1,144 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#import <XCTest/XCTest.h>
+#import "views/VLCPlaybackProgressSlider.h"
+#import "timeline/VLCTimelineContext.h"
+#import "timeline/VLCThumbnailService.h"
+
+/* Private seams only: the production class has no public testing API. */
+@interface VLCPlaybackProgressSlider (SnapshotTesting)
+- (NSDictionary *)timelineSnapshot;
+- (void)reportHoverAtPoint:(NSPoint)point;
+- (BOOL)previewCompletionIsCurrentForPresentation:(uint64_t)presentation generation:(id)generation;
+- (void)observeHoverLifecycleIfNeeded;
+@end
+
+@interface VLCThumbnailService (DelayedTestReply)
++ (void)deliverDelayedCompletion;
+@end
+
+@interface VLCNotifyingHoverSlider : VLCPlaybackProgressSlider
+@property BOOL notifyDuringSnapshot;
+@property NSUInteger snapshotCalls;
+@property NSUInteger showCalls;
+@property vlc_tick_t shownTime;
+@property id contextDuration;
+@property BOOL eligible;
+@property BOOL previewsEnabled;
+@end
+@implementation VLCNotifyingHoverSlider
+- (BOOL)hoverIsAvailable { return YES; }
+- (void)viewDidChangeEffectiveAppearance { }
+- (void)createHoverWindowIfNeeded { }
+- (void)showHoverAtSliderX:(CGFloat)x time:(vlc_tick_t)time { ++_showCalls; _shownTime = time; }
+- (BOOL)timelinePreviewsEnabled { return _previewsEnabled; }
+- (NSDictionary *)timelineSnapshot
+{
+    ++_snapshotCalls;
+    if (_notifyDuringSnapshot)
+        [NSNotificationCenter.defaultCenter postNotificationName:VLCTimelineContextChanged object:nil];
+    return @{ @"eligible": @(_eligible), @"generation": @"test:1",
+              @"duration": _contextDuration ?: @0 };
+}
+@end
+
+@interface VLCTimelineHoverReentrancyTest : XCTestCase
+@end
+@implementation VLCTimelineHoverReentrancyTest
+- (void)testSnapshotNotificationPrecedesNewHoverPresentation
+{
+    VLCNotifyingHoverSlider *slider = [[VLCNotifyingHoverSlider alloc] initWithFrame:NSMakeRect(0, 0, 100, 20)];
+    [slider observeHoverLifecycleIfNeeded];
+    slider.mediaDuration = 10000000;
+    slider.notifyDuringSnapshot = YES;
+    [slider reportHoverAtPoint:NSMakePoint(50, 10)];
+    XCTAssertEqual(slider.snapshotCalls, 1u);
+    XCTAssertEqual(slider.showCalls, 1u);
+    XCTAssertTrue([[slider valueForKey:@"hovering"] boolValue]);
+}
+- (void)testSnapshotNotificationInvalidatesCompletionBeforeGuardReadsState
+{
+    VLCNotifyingHoverSlider *slider = [[VLCNotifyingHoverSlider alloc] initWithFrame:NSMakeRect(0, 0, 100, 20)];
+    [slider observeHoverLifecycleIfNeeded];
+    slider.mediaDuration = 10000000;
+    [slider reportHoverAtPoint:NSMakePoint(50, 10)];
+    uint64_t presentation = [[slider valueForKey:@"previewPresentation"] unsignedLongLongValue];
+    slider.notifyDuringSnapshot = YES;
+    XCTAssertFalse([slider previewCompletionIsCurrentForPresentation:presentation generation:@"test:1"]);
+    XCTAssertFalse([[slider valueForKey:@"hovering"] boolValue]);
+    XCTAssertEqual(slider.snapshotCalls, 2u);
+}
+- (VLCNotifyingHoverSlider *)sliderWithBarDuration:(vlc_tick_t)barDuration contextDuration:(id)duration
+{
+    [VLCThumbnailService.sharedService cancel];
+    VLCNotifyingHoverSlider *slider = [[VLCNotifyingHoverSlider alloc] initWithFrame:NSMakeRect(0, 0, 100, 20)];
+    [slider observeHoverLifecycleIfNeeded];
+    slider.mediaDuration = barDuration;
+    slider.contextDuration = duration;
+    slider.eligible = YES;
+    slider.previewsEnabled = YES;
+    return slider;
+}
+- (void)testFreshLongerDurationDrivesBothPointerAndActualRequest
+{
+    VLCNotifyingHoverSlider *slider = [self sliderWithBarDuration:10000000 contextDuration:@20000000];
+    [slider reportHoverAtPoint:NSMakePoint(50, 10)];
+    NSDictionary *metrics = VLCThumbnailService.sharedService.metrics;
+    XCTAssertEqual(slider.shownTime, 10000000);
+    XCTAssertEqual([metrics[@"lastRequest"][@"time"] longLongValue], slider.shownTime);
+    XCTAssertEqual([metrics[@"lastRequest"][@"context"][@"duration"] longLongValue], 20000000);
+    XCTAssertEqual(slider.mediaDuration, 10000000);
+}
+- (void)testFreshShorterDurationDrivesBothPointerAndActualRequest
+{
+    VLCNotifyingHoverSlider *slider = [self sliderWithBarDuration:20000000 contextDuration:@10000000];
+    [slider reportHoverAtPoint:NSMakePoint(50, 10)];
+    XCTAssertEqual(slider.shownTime, 5000000);
+    XCTAssertEqual([VLCThumbnailService.sharedService.metrics[@"lastRequest"][@"time"] longLongValue], 5000000);
+    XCTAssertEqual(slider.mediaDuration, 20000000);
+}
+- (void)testFreshDurationRightEdgeKeepsCaptionAndClampsRequest
+{
+    VLCNotifyingHoverSlider *slider = [self sliderWithBarDuration:0 contextDuration:@20000000];
+    [slider reportHoverAtPoint:NSMakePoint(94, 10)];
+    XCTAssertEqual(slider.shownTime, 20000000);
+    XCTAssertEqual([VLCThumbnailService.sharedService.metrics[@"lastRequest"][@"time"] longLongValue], 19999999);
+    XCTAssertEqual(slider.mediaDuration, 0);
+}
+- (void)testDurationChangeRejectsDelayedCompletionEvenWithoutGenerationAnnouncement
+{
+    VLCNotifyingHoverSlider *slider = [self sliderWithBarDuration:10000000 contextDuration:@20000000];
+    [slider reportHoverAtPoint:NSMakePoint(50, 10)];
+    NSImageView *imageView = [[NSImageView alloc] initWithFrame:NSMakeRect(0, 0, 32, 18)];
+    imageView.image = [[NSImage alloc] initWithSize:NSMakeSize(32, 18)];
+    [slider setValue:imageView forKey:@"hoverImage"];
+    XCTAssertTrue(imageView.image != nil);
+    slider.contextDuration = @30000000; /* Same mocked generation: capture is independently checked. */
+    [VLCThumbnailService deliverDelayedCompletion];
+    XCTAssertEqual(slider.showCalls, 1u);
+    XCTAssertTrue(imageView.image == nil);
+    XCTAssertFalse([[slider valueForKey:@"hovering"] boolValue]);
+    XCTAssertEqual([[slider valueForKey:@"previewRequest"] unsignedIntegerValue], 0u);
+}
+- (void)testMalformedOrIneligibleContextUsesTimeOnlyFallback
+{
+    for (id duration in @[@YES, @1.5, @"20000000", @0, @-1]) {
+        VLCNotifyingHoverSlider *slider = [self sliderWithBarDuration:10000000 contextDuration:duration];
+        [slider reportHoverAtPoint:NSMakePoint(50, 10)];
+        XCTAssertEqual(slider.shownTime, 5000000);
+        XCTAssertEqual([VLCThumbnailService.sharedService.metrics[@"requests"] unsignedIntegerValue], 0u);
+    }
+    VLCNotifyingHoverSlider *slider = [self sliderWithBarDuration:10000000 contextDuration:@20000000];
+    slider.eligible = NO;
+    [slider reportHoverAtPoint:NSMakePoint(50, 10)];
+    XCTAssertEqual(slider.shownTime, 5000000);
+    XCTAssertEqual([VLCThumbnailService.sharedService.metrics[@"requests"] unsignedIntegerValue], 0u);
+}
+- (void)testDisabledPreviewUsesFreshPointerTimeWithoutRequest
+{
+    VLCNotifyingHoverSlider *slider = [self sliderWithBarDuration:10000000 contextDuration:@20000000];
+    slider.previewsEnabled = NO;
+    [slider reportHoverAtPoint:NSMakePoint(50, 10)];
+    XCTAssertEqual(slider.shownTime, 10000000);
+    XCTAssertEqual([VLCThumbnailService.sharedService.metrics[@"requests"] unsignedIntegerValue], 0u);
+}
+@end
