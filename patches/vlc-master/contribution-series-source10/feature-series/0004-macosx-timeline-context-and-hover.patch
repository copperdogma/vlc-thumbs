+/* Hover coordinates use the actual bar, independently of knob geometry. */
+static inline NSRect VLCTimelineHoverRect(NSRect bounds, NSRect bar)
+{
+    const CGFloat left = MAX(NSMinX(bounds), NSMinX(bar));
+    const CGFloat right = MIN(NSMaxX(bounds), NSMaxX(bar));
+    return NSMakeRect(left, NSMidY(bar) - 16.0, MAX(0.0, right - left), 32.0);
+}
+
+static inline CGFloat VLCTimelineHoverFraction(CGFloat x, NSRect bar)
+{
+    return NSWidth(bar) > 0 ? MAX(0.0, MIN(1.0, (x - NSMinX(bar)) / NSWidth(bar))) : 0.0;
+}
+
+/* Media requests use [0, duration); the pointer label may show duration. */
+static inline vlc_tick_t VLCTimelinePreviewRequestTime(vlc_tick_t pointerTime, vlc_tick_t duration)
+{
+    return MAX((vlc_tick_t)0, MIN(pointerTime, MAX((vlc_tick_t)0, duration - 1)));
+}
+
+static inline BOOL VLCTimelinePreviewIsCurrent(uint64_t current, uint64_t expected,
+                                              id generation, id expectedGeneration)
+{
+    return current == expected && generation != nil &&
