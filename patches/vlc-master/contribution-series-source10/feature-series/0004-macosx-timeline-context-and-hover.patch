+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Link only into the isolated headless slider test, never into the GUI plugin.
+ * No NSWindow, player, source IO or decoder is created by these narrow doubles. */
+#import "main/VLCMain.h"
+#import "views/VLCPlaybackProgressSliderCell.h"
+#import "timeline/VLCTimelineContext.h"
+#import "timeline/VLCThumbnailService.h"
+NSString * const VLCTimelineContextChanged = @"VLCTimelineContextChanged";
+NSString *VLCConfigurationChangedNotification = @"VLCConfigurationChangedNotification";
+intf_thread_t *getIntf(void) { return NULL; }
+NSString *toNSStr(const char *str) { return str ? [NSString stringWithUTF8String:str] : @""; }
+@implementation VLCPlaybackProgressSliderCell
+- (NSRect)barRectFlipped:(BOOL)flipped { return NSMakeRect(6, 8, 88, 4); }
+- (void)setSliderStyleLight { }
+- (void)setSliderStyleDark { }
+@end
+@implementation VLCTimelineContext
++ (instancetype)sharedContext { return nil; }
+- (NSDictionary *)snapshot { return @{}; }
+- (void)refresh { }
+- (void)invalidate { }
+@end
+static NSDictionary *lastRequest;
+static VLCThumbnailCompletion delayedCompletion;
+static NSUInteger requests;
+@implementation VLCThumbnailService
++ (instancetype)sharedService
+{
+    static VLCThumbnailService *service;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{ service = [self new]; });
+    return service;
+}
+- (NSUInteger)requestForContext:(NSDictionary *)context time:(int64_t)time completion:(VLCThumbnailCompletion)completion
+{
+    lastRequest = @{ @"time": @(time), @"context": [context copy] };
+    delayedCompletion = [completion copy];
+    return ++requests;
+}
+/* Retain the captured callback despite cancel, modeling already-dispatched work. */
++ (void)deliverDelayedCompletion
+{
+    if (delayedCompletion)
+        delayedCompletion(nil, @{ @"error": @"test-unavailable" });
+}
+- (instancetype)initWithHelperPath:(NSString *)helperPath cacheRoot:(NSString *)cacheRoot { return [super init]; }
+- (void)prepareContext:(NSDictionary *)context enabled:(BOOL)enabled { }
+- (void)cancelRequest:(NSUInteger)token { }
+- (void)cancel { requests = 0; lastRequest = nil; delayedCompletion = nil; }
+- (void)shutdown { }
+- (NSDictionary *)metrics { return @{ @"requests": @(requests), @"lastRequest": lastRequest ?: @{} }; }
+@end
