@@ -0,0 +1,168 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#import "VLCTimelineContext.h"
+#import "VLCThumbnailService.h"
+#import "main/VLCMain.h"
+#import "playqueue/VLCPlayQueueController.h"
+#import "playqueue/VLCPlayerController.h"
+
+NSString * const VLCTimelineContextChanged = @"VLCTimelineContextChanged";
+
+@interface VLCTimelineContext ()
+@property (copy) NSString *session;
+@property NSUInteger generation;
+@property (copy) NSDictionary *current;
+@property (copy) NSDictionary *(^snapshotProvider)(void);
+@property (copy) BOOL (^enabledProvider)(void);
+@property (copy) void (^prepare)(NSDictionary *, BOOL);
+@property (strong) NSNotificationCenter *notificationCenter;
+@property BOOL lastEnabled;
+@property BOOL stopped;
+- (instancetype)initWithSnapshotProvider:(NSDictionary *(^)(void))snapshotProvider
+                        enabledProvider:(BOOL (^)(void))enabledProvider
+                                prepare:(void (^)(NSDictionary *, BOOL))prepare
+                     notificationCenter:(NSNotificationCenter *)notificationCenter
+                                 player:(id)player;
+@end
+
+@implementation VLCTimelineContext
++ (instancetype)sharedContext
+{
+    NSAssert(NSThread.isMainThread, @"Timeline context belongs to the main thread");
+    static VLCTimelineContext *context;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        VLCPlayerController *player = VLCMain.sharedInstance.playQueueController.playerController;
+        context = [[self alloc] initWithSnapshotProvider:^{ return [player timelinePreviewSnapshot]; }
+            enabledProvider:^{ return (BOOL)(getIntf() && var_InheritBool(getIntf(), "macosx-timeline-previews")); }
+            prepare:^(NSDictionary *snapshot, BOOL enabled) {
+                [[VLCThumbnailService sharedService] prepareContext:snapshot enabled:enabled];
+            } notificationCenter:NSNotificationCenter.defaultCenter player:player];
+    });
+    return context;
+}
+
+- (instancetype)initWithSnapshotProvider:(NSDictionary *(^)(void))snapshotProvider
+                        enabledProvider:(BOOL (^)(void))enabledProvider
+                                prepare:(void (^)(NSDictionary *, BOOL))prepare
+                     notificationCenter:(NSNotificationCenter *)notificationCenter
+                                 player:(id)player
+{
+    self = [super init];
+    if (self) {
+        _session = NSUUID.UUID.UUIDString;
+        _current = @{};
+        _snapshotProvider = [snapshotProvider copy];
+        _enabledProvider = [enabledProvider copy];
+        _prepare = [prepare copy];
+        _notificationCenter = notificationCenter;
+        NSArray *events = @[VLCPlayerCurrentMediaItemChanged, VLCPlayerTrackListChanged,
+            VLCPlayerTrackSelectionChanged, VLCPlayerLengthChanged, VLCPlayerCapabilitiesChanged,
+            VLCPlayerStateChanged, VLCPlayerProgramSelectionChanged, VLCPlayerProgramListChanged,
+            VLCPlayerTitleSelectionChanged, VLCPlayerTitleListChanged];
+        for (NSString *event in events)
+            [_notificationCenter addObserver:self selector:@selector(playerChanged:) name:event object:player];
+        [_notificationCenter addObserver:self selector:@selector(preferenceChanged:)
+            name:VLCConfigurationChangedNotification object:nil];
+        [_notificationCenter addObserver:self selector:@selector(applicationWillTerminate:)
+            name:NSApplicationWillTerminateNotification object:nil];
+        [self refresh];
+    }
+    return self;
+}
+
+- (void)dealloc
+{
+    [_notificationCenter removeObserver:self];
+}
+
+- (void)playerChanged:(NSNotification *)notification
+{
+    /* The notification argument carries no media values. Always read the latest player. */
+    BOOL reopened = [notification.name isEqualToString:VLCPlayerCurrentMediaItemChanged];
+    if (!NSThread.isMainThread) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            if (self.stopped)
+                return;
+            if (reopened)
+                [self invalidateSnapshot];
+            [self refresh];
+        });
+        return;
+    }
+    if (_stopped)
+        return;
+    if (reopened)
+        [self invalidateSnapshot];
+    [self refresh];
+}
+
+- (void)preferenceChanged:(NSNotification *)notification
+{
+    /* Inherit the effective runtime value; saved preferences must not override CLI values. */
+    if (!NSThread.isMainThread) {
+        dispatch_async(dispatch_get_main_queue(), ^{ [self refresh]; });
+        return;
+    }
+    [self refresh];
+}
+
+- (void)applicationWillTerminate:(NSNotification *)notification
+{
+    if (!NSThread.isMainThread) {
+        dispatch_async(dispatch_get_main_queue(), ^{ [self applicationWillTerminate:nil]; });
+        return;
+    }
+    [self invalidate];
+}
+
+- (NSDictionary *)snapshot
+{
+    NSAssert(NSThread.isMainThread, @"Timeline context belongs to the main thread");
+    [self refresh];
+    return _current;
+}
+
+- (void)refresh
+{
+    NSAssert(NSThread.isMainThread, @"Timeline context belongs to the main thread");
+    if (_stopped)
+        return;
+    NSDictionary *values = [[NSDictionary alloc] initWithDictionary:_snapshotProvider() copyItems:YES];
+    NSMutableDictionary *previous = [_current mutableCopy];
+    [previous removeObjectForKey:@"generation"];
+    BOOL changed = ![previous isEqualToDictionary:values];
+    if (changed)
+        _generation++;
+    NSMutableDictionary *next = [values mutableCopy];
+    next[@"generation"] = [NSString stringWithFormat:@"%@-%lu", _session, (unsigned long)_generation];
+    _current = [next copy];
+    BOOL enabled = _enabledProvider();
+    BOOL enabledChanged = enabled != _lastEnabled;
+    _lastEnabled = enabled; /* Commit before synchronous external callbacks can read snapshot. */
+    if (changed || enabledChanged) {
+        _prepare(_current, enabled);
+        [_notificationCenter postNotificationName:VLCTimelineContextChanged object:self];
+    }
+}
+
+- (void)invalidate
+{
+    NSAssert(NSThread.isMainThread, @"Timeline context belongs to the main thread");
+    if (_stopped)
+        return;
+    _stopped = YES;
+    [_notificationCenter removeObserver:self];
+    [self invalidateSnapshot];
+}
+
+- (void)invalidateSnapshot
+{
+    NSAssert(NSThread.isMainThread, @"Timeline context belongs to the main thread");
+    _generation++;
+    _current = @{@"generation": [NSString stringWithFormat:@"%@-%lu", _session, (unsigned long)_generation],
+        @"sourceEpoch": @0, @"eligible": @NO, @"duration": @0, @"videoStableID": @"", @"videoInputID": @-1, @"videoCount": @0};
+    _lastEnabled = NO;
+    _prepare(_current, NO);
+    [_notificationCenter postNotificationName:VLCTimelineContextChanged object:self];
+}
+@end
