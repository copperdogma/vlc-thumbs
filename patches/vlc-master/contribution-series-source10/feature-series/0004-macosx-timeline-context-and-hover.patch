diff --git a/modules/gui/macosx/timeline/VLCTimelineContextTests.m b/modules/gui/macosx/timeline/VLCTimelineContextTests.m
new file mode 100644
index 0000000000000000000000000000000000000000..a722ca104603f042bb165172941d148f6d508c17
--- /dev/null
+++ b/modules/gui/macosx/timeline/VLCTimelineContextTests.m
@@ -0,0 +1,205 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#import <XCTest/XCTest.h>
+#import <AppKit/AppKit.h>
+#import "VLCTimelineContext.h"
+#import "playqueue/VLCPlayerController.h"
+extern NSString *VLCConfigurationChangedNotification;
+
+/* Private dependency injection keeps these lifecycle tests independent of files/decoders. */
+@interface VLCTimelineContext (Testing)
+- (instancetype)initWithSnapshotProvider:(NSDictionary *(^)(void))snapshotProvider
+                        enabledProvider:(BOOL (^)(void))enabledProvider
+                                prepare:(void (^)(NSDictionary *, BOOL))prepare
+                     notificationCenter:(NSNotificationCenter *)notificationCenter
+                                 player:(id)player;
+@end
+
+@interface VLCTimelineContextTests : XCTestCase
+@end
+
+@implementation VLCTimelineContextTests
+- (NSMutableDictionary *)eligibleValues
+{
+    return [@{@"sourceEpoch": @1, @"url": [NSURL fileURLWithPath:@"/fixture/movie.mkv"],
+        @"duration": @12000000, @"eligible": @YES, @"videoStableID": @"video/1",
+        @"videoInputID": @1, @"videoCount": @2} mutableCopy];
+}
+
+- (void)testSourceEpochDetectsSameURIReopenBeforeMainNotification
+{
+    NSMutableDictionary *values = [self eligibleValues];
+    NSMutableArray *prepared = [NSMutableArray array];
+    VLCTimelineContext *context = [[VLCTimelineContext alloc] initWithSnapshotProvider:^{ return values; }
+        enabledProvider:^{ return YES; } prepare:^(NSDictionary *value, BOOL enabled) { (void)value; (void)enabled;
+            [prepared addObject:value];
+        } notificationCenter:[NSNotificationCenter new] player:[NSObject new]];
+    NSDictionary *first = context.snapshot;
+    values[@"sourceEpoch"] = @2; /* synchronous listener update, no main notification yet */
+    NSDictionary *second = context.snapshot;
+    XCTAssertNotEqualObjects(first[@"generation"], second[@"generation"]);
+    XCTAssertEqualObjects(first[@"url"], second[@"url"]);
+    XCTAssertEqualObjects(second[@"sourceEpoch"], @2);
+    XCTAssertEqual(prepared.count, 2u);
+    XCTAssertEqualObjects(first[@"sourceEpoch"], @1); /* no dictionary alias */
+}
+
+- (void)testUnchangedPointerChecksCannotRenewPreparation
+{
+    NSDictionary *values = [self eligibleValues];
+    __block NSUInteger preparations = 0;
+    VLCTimelineContext *context = [[VLCTimelineContext alloc] initWithSnapshotProvider:^{ return values; }
+        enabledProvider:^{ return YES; } prepare:^(NSDictionary *value, BOOL enabled) { (void)value; (void)enabled; preparations++; }
+        notificationCenter:[NSNotificationCenter new] player:[NSObject new]];
+    NSString *generation = context.snapshot[@"generation"];
+    for (NSUInteger i = 0; i < 20; i++) {
+        XCTAssertEqualObjects(context.snapshot[@"generation"], generation);
+        [context refresh];
+    }
+    XCTAssertEqual(preparations, 1u);
+}
+
+- (void)testOwnedStringsAndEachSelectionComponentInvalidates
+{
+    NSMutableDictionary *values = [self eligibleValues];
+    NSMutableString *identifier = [@"video/1" mutableCopy];
+    values[@"videoStableID"] = identifier;
+    VLCTimelineContext *context = [[VLCTimelineContext alloc] initWithSnapshotProvider:^{ return values; }
+        enabledProvider:^{ return YES; } prepare:^(NSDictionary *value, BOOL enabled) { (void)value; (void)enabled;}
+        notificationCenter:[NSNotificationCenter new] player:[NSObject new]];
+    NSDictionary *old = context.snapshot;
+    [identifier setString:@"video/2"];
+    XCTAssertEqualObjects(old[@"videoStableID"], @"video/1");
+    NSDictionary *next = context.snapshot;
+    XCTAssertNotEqualObjects(old[@"generation"], next[@"generation"]);
+    for (NSString *key in @[@"videoInputID", @"videoCount", @"duration", @"eligible"]) {
+        old = context.snapshot;
+        values[key] = [key isEqualToString:@"eligible"] ? @NO : @3;
+        XCTAssertNotEqualObjects(old[@"generation"], context.snapshot[@"generation"]);
+    }
+}
+
+- (void)testSameURIEventAndDelayedNotificationUseLatestSnapshot
+{
+    NSMutableDictionary *values = [self eligibleValues];
+    NSNotificationCenter *center = [NSNotificationCenter new];
+    NSObject *player = [NSObject new];
+    VLCTimelineContext *context = [[VLCTimelineContext alloc] initWithSnapshotProvider:^{ return values; }
+        enabledProvider:^{ return YES; } prepare:^(NSDictionary *value, BOOL enabled) { (void)value; (void)enabled;}
+        notificationCenter:center player:player];
+    NSString *first = context.snapshot[@"generation"];
+    [center postNotificationName:VLCPlayerCurrentMediaItemChanged object:player];
+    XCTAssertNotEqualObjects(first, context.snapshot[@"generation"]);
+    XCTestExpectation *queued = [self expectationWithDescription:@"queued refresh reads latest values"];
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0), ^{
+        [center postNotificationName:VLCPlayerTrackSelectionChanged object:player
+            userInfo:@{@"videoStableID": @"stale"}];
+        dispatch_async(dispatch_get_main_queue(), ^{
+            XCTAssertEqualObjects(context.snapshot[@"videoStableID"], @"video/2");
+            [queued fulfill];
+        });
+    });
+    values[@"videoStableID"] = @"video/2";
+    values[@"videoInputID"] = @2;
+    [self waitForExpectations:@[queued] timeout:2];
+}
+
+- (void)testReentrantObserverReadsSnapshotDuringToggleAndDirectShutdown
+{
+    NSDictionary *values = [self eligibleValues];
+    __block BOOL effectiveEnabled = YES;
+    __block NSUInteger preparations = 0;
+    __block NSUInteger notifications = 0;
+    NSNotificationCenter *center = [NSNotificationCenter new];
+    NSObject *player = [NSObject new];
+    VLCTimelineContext *context = [[VLCTimelineContext alloc] initWithSnapshotProvider:^{ return values; }
+        enabledProvider:^{ return effectiveEnabled; } prepare:^(NSDictionary *value, BOOL enabled) {
+            (void)value; (void)enabled; preparations++;
+        } notificationCenter:center player:player];
+    __block __weak id observer;
+    __weak NSNotificationCenter *observedCenter = center;
+    __weak VLCTimelineContext *observedContext = context;
+    observer = [center addObserverForName:VLCTimelineContextChanged object:context queue:nil
+        usingBlock:^(NSNotification *notification) {
+            (void)notification;
+            notifications++;
+            if (notifications > 4) {
+                [observedCenter removeObserver:observer]; /* bound the regression's former recursive failure */
+                XCTFail(@"Reentrant snapshot recursively published a context change");
+                return;
+            }
+            NSDictionary *snapshot = observedContext.snapshot;
+            XCTAssertNotNil(snapshot[@"generation"]);
+        }];
+    effectiveEnabled = NO;
+    [center postNotificationName:VLCConfigurationChangedNotification object:nil];
+    XCTAssertEqual(preparations, 2u);
+    XCTAssertEqual(notifications, 1u);
+    /* Queue a core-style media event before VLCMain's direct shutdown call. */
+    dispatch_semaphore_t queued = dispatch_semaphore_create(0);
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0), ^{
+        XCTAssertFalse(NSThread.isMainThread);
+        [center postNotificationName:VLCPlayerCurrentMediaItemChanged object:player];
+        dispatch_semaphore_signal(queued);
+    });
+    XCTAssertEqual(dispatch_semaphore_wait(queued, dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC)), 0);
+    /* This is VLCMain's direct shutdown call, before the standard app notification. */
+    [context invalidate];
+    XCTestExpectation *drained = [self expectationWithDescription:@"queued player event drained after shutdown"];
+    dispatch_async(dispatch_get_main_queue(), ^{ [drained fulfill]; });
+    [self waitForExpectations:@[drained] timeout:2];
+    XCTAssertFalse([context.snapshot[@"eligible"] boolValue]);
+    XCTAssertEqual(preparations, 3u);
+    XCTAssertEqual(notifications, 2u);
+    [center postNotificationName:NSApplicationWillTerminateNotification object:nil];
+    [context refresh];
+    [context invalidate];
+    XCTAssertFalse([context.snapshot[@"eligible"] boolValue]);
+    XCTAssertEqual(preparations, 3u);
+    XCTAssertEqual(notifications, 2u);
+    [center removeObserver:observer];
+}
+
+- (void)testConfigurationNotificationRefreshesEffectivePreferenceOnce
+{
+    NSDictionary *values = [self eligibleValues];
+    __block BOOL effectiveEnabled = YES;
+    __block NSUInteger preparations = 0;
+    NSNotificationCenter *center = [NSNotificationCenter new];
+    VLCTimelineContext *context = [[VLCTimelineContext alloc] initWithSnapshotProvider:^{ return values; }
+        enabledProvider:^{ return effectiveEnabled; } prepare:^(NSDictionary *value, BOOL enabled) {
+            (void)value; (void)enabled; preparations++;
+        } notificationCenter:center player:[NSObject new]];
+    NSString *generation = context.snapshot[@"generation"];
+    effectiveEnabled = NO;
+    [center postNotificationName:VLCConfigurationChangedNotification object:nil];
+    XCTAssertEqual(preparations, 2u);
+    [center postNotificationName:VLCConfigurationChangedNotification object:nil];
+    XCTAssertEqual(preparations, 2u); /* duplicate configuration announcements do not renew preparation */
+    XCTAssertEqualObjects(generation, context.snapshot[@"generation"]);
+}
+
+- (void)testPreferenceUsesEffectiveValueAndTerminationCannotRestart
+{
+    NSDictionary *values = [self eligibleValues];
+    __block BOOL effectiveEnabled = YES;
+    __block BOOL lastEnabled = YES;
+    __block NSUInteger preparations = 0;
+    NSNotificationCenter *center = [NSNotificationCenter new];
+    VLCTimelineContext *context = [[VLCTimelineContext alloc] initWithSnapshotProvider:^{ return values; }
+        enabledProvider:^{ return effectiveEnabled; } prepare:^(NSDictionary *value, BOOL enabled) { (void)value; (void)enabled;
+            lastEnabled = enabled; preparations++;
+        } notificationCenter:center player:[NSObject new]];
+    NSString *generation = context.snapshot[@"generation"];
+    [center postNotificationName:VLCConfigurationChangedNotification object:nil userInfo:@{@"enabled": @NO}];
+    XCTAssertTrue(lastEnabled); /* saved value does not override effective CLI value */
+    effectiveEnabled = NO;
+    [center postNotificationName:VLCConfigurationChangedNotification object:nil];
+    XCTAssertFalse(lastEnabled);
+    XCTAssertEqualObjects(generation, context.snapshot[@"generation"]);
+    [center postNotificationName:NSApplicationWillTerminateNotification object:nil];
+    NSUInteger stoppedPreparations = preparations;
+    [context refresh];
+    XCTAssertFalse([context.snapshot[@"eligible"] boolValue]);
+    XCTAssertEqual(preparations, stoppedPreparations);
+}
+@end
diff --git a/modules/gui/macosx/timeline/VLCTimelinePlayerContextTest.m b/modules/gui/macosx/timeline/VLCTimelinePlayerContextTest.m
new file mode 100644
index 0000000000000000000000000000000000000000..a70a29edeb20360c964545b351e431dff8148165
--- /dev/null
+++ b/modules/gui/macosx/timeline/VLCTimelinePlayerContextTest.m
@@ -0,0 +1,217 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#import <XCTest/XCTest.h>
+#import <Cocoa/Cocoa.h>
+#include <vlc_common.h>
+#include <vlc_interface.h>
+#include <vlc_configuration.h>
+#include <vlc_player.h>
+#include "lib/libvlc_internal.h"
+#import "playqueue/VLCPlayerController.h"
+#import "timeline/VLCTimelineContext.h"
+#import "tests/VLCInputItemTestSupport.h"
+#import "os-integration/VLCRemoteControlService.h"
+
+/* The normal test bundle does not link the application/configuration UI. */
+NSString *VLCConfigurationChangedNotification = @"VLCConfigurationChangedNotification";
+
+/* Link-only support for an application-launch path this test must not enter. */
+@implementation VLCRemoteControlService
+- (instancetype)init
+{
+    [NSException raise:NSInternalInconsistencyException format:@"Unexpected remote-control launch in player context test"];
+    return nil;
+}
+- (void)subscribeToRemoteCommands
+{
+    [NSException raise:NSInternalInconsistencyException format:@"Unexpected remote-control subscription"];
+}
+- (void)unsubscribeFromRemoteCommands
+{
+    [NSException raise:NSInternalInconsistencyException format:@"Unexpected remote-control teardown"];
+}
+@end
+
+@interface VLCPlayerController (TimelinePlayerContextTesting)
+- (void)applicationWillTerminate:(NSNotification *)notification;
+@end
+@interface VLCTimelineContext (TimelinePlayerContextTesting)
+- (instancetype)initWithSnapshotProvider:(NSDictionary *(^)(void))snapshotProvider
+                        enabledProvider:(BOOL (^)(void))enabledProvider
+                                prepare:(void (^)(NSDictionary *, BOOL))prepare
+                     notificationCenter:(NSNotificationCenter *)notificationCenter
+                                 player:(id)player;
+@end
+
+struct MediaObservation {
+    __unsafe_unretained dispatch_semaphore_t changed;
+    input_item_t *lastItem; /* Comparison only; the test retains both inputs. */
+    unsigned count;        /* Read and written only under the real player lock. */
+};
+
+static void ObserveCurrentMedia(vlc_player_t *player, input_item_t *item, void *opaque)
+{
+    (void)player;
+    struct MediaObservation *observation = opaque;
+    observation->lastItem = item;
+    observation->count++;
+    dispatch_semaphore_signal(observation->changed);
+}
+
+@interface VLCTimelinePlayerContextTest : XCTestCase
+@end
+
+@implementation VLCTimelinePlayerContextTest
+- (void)testSameURIReopenAdvancesRealEpochBeforeMainNotification
+{
+    XCTAssertTrue(NSThread.isMainThread);
+    if (!NSThread.isMainThread)
+        return;
+
+    const char *arguments[] = { "--ignore-config", "-Idummy", "--no-media-library",
+        "--vout=none", "--aout=none", "--no-audio", "--no-video", "--no-plugins-scan" };
+    libvlc_instance_t *instance = libvlc_new(ARRAY_SIZE(arguments), arguments);
+    XCTAssertNotEqual(instance, NULL);
+    if (!instance)
+        return;
+    intf_thread_t *interface = vlc_object_create(instance->p_libvlc_int, sizeof(*interface));
+    vlc_player_t *player = NULL;
+    vlc_player_listener_id *listener = NULL;
+    input_item_t *firstItem = NULL;
+    input_item_t *secondItem = NULL;
+    VLCPlayerController *controller = nil;
+    VLCTimelineContext *context = nil;
+    id notificationObserver = nil;
+    NSNotificationCenter *center = NSNotificationCenter.defaultCenter;
+    dispatch_semaphore_t changed = dispatch_semaphore_create(0);
+    struct MediaObservation observation = { .changed = changed };
+    __block NSUInteger mainNotifications = 0;
+
+    @try {
+        XCTAssertNotEqual(interface, NULL);
+        if (!interface)
+            return;
+        /* The focused target supplies the normal build's modules/plugins.dat.
+         * Read its descriptors without loading the macOS UI dylib (which would
+         * duplicate classes in this test bundle). Teardown reads this option. */
+        int controlOtherPlayersType = config_GetType("macosx-control-itunes");
+        XCTAssertEqual(controlOtherPlayersType, VLC_VAR_INTEGER,
+            @"Generate the normal modules/plugins.dat and set VLC_PLUGIN_PATH to its modules directory");
+        if (controlOtherPlayersType != VLC_VAR_INTEGER)
+            return; /* Never construct a controller whose normal teardown cannot read its option. */
+        VLCInputItemTestSetInterface(interface);
+        player = vlc_player_New(VLC_OBJECT(instance->p_libvlc_int), VLC_PLAYER_LOCK_NORMAL);
+        XCTAssertNotEqual(player, NULL);
+        if (!player)
+            return;
+        controller = [[VLCPlayerController alloc] initWithPlayer:player];
+        XCTAssertNotNil(controller);
+        if (!controller)
+            return;
+        static const struct vlc_player_cbs callbacks = { .on_current_media_changed = ObserveCurrentMedia };
+        vlc_player_Lock(player);
+        listener = vlc_player_AddListener(player, &callbacks, &observation);
+        vlc_player_Unlock(player);
+        XCTAssertNotEqual(listener, NULL);
+        if (!listener)
+            return;
+        notificationObserver = [center addObserverForName:VLCPlayerCurrentMediaItemChanged
+            object:controller queue:nil usingBlock:^(NSNotification *notification) {
+                (void)notification;
+                XCTAssertTrue(NSThread.isMainThread);
+                mainNotifications++;
+            }];
+        firstItem = input_item_New("file:///vlc-timeline-test/same.mkv", "same");
+        secondItem = input_item_New("file:///vlc-timeline-test/same.mkv", "same");
+        XCTAssertNotEqual(firstItem, NULL);
+        XCTAssertNotEqual(secondItem, NULL);
+        if (!firstItem || !secondItem)
+            return;
+
+        /* Never start playback: this proves epoch/ownership, not selected-track or duration eligibility. */
+        vlc_player_Lock(player);
+        int result = vlc_player_SetCurrentMedia(player, firstItem);
+        vlc_player_Unlock(player);
+        XCTAssertEqual(result, VLC_SUCCESS);
+        if (result != VLC_SUCCESS)
+            return;
+        long waited = dispatch_semaphore_wait(changed, dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC));
+        XCTAssertEqual(waited, 0L);
+        if (waited)
+            return;
+        vlc_player_Lock(player);
+        XCTAssertEqual(observation.lastItem, firstItem);
+        XCTAssertEqual(observation.count, 1u);
+        vlc_player_Unlock(player);
+        XCTAssertEqual(mainNotifications, 0u); /* No main-queue drain before either snapshot. */
+        NSDictionary *first = [controller timelinePreviewSnapshot];
+        XCTAssertGreaterThan([first[@"sourceEpoch"] unsignedLongLongValue], 0ull);
+        XCTAssertFalse([first[@"eligible"] boolValue]);
+        XCTAssertEqualObjects(first[@"videoCount"], @0);
+        XCTAssertEqualObjects(first[@"duration"], @0);
+        context = [[VLCTimelineContext alloc] initWithSnapshotProvider:^{ return [controller timelinePreviewSnapshot]; }
+            enabledProvider:^{ return YES; } prepare:^(NSDictionary *snapshot, BOOL enabled) {
+                (void)snapshot; (void)enabled;
+            } notificationCenter:center player:controller];
+        NSDictionary *firstContext = context.snapshot;
+
+        /* SetCurrentMedia can notify synchronously or from its destructor thread; both are player-locked. */
+        vlc_player_Lock(player);
+        result = vlc_player_SetCurrentMedia(player, secondItem);
+        vlc_player_Unlock(player);
+        XCTAssertEqual(result, VLC_SUCCESS);
+        if (result != VLC_SUCCESS)
+            return;
+        waited = dispatch_semaphore_wait(changed, dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC));
+        XCTAssertEqual(waited, 0L);
+        if (waited)
+            return;
+        vlc_player_Lock(player);
+        XCTAssertEqual(observation.lastItem, secondItem);
+        XCTAssertEqual(observation.count, 2u);
+        vlc_player_Unlock(player);
+        XCTAssertEqual(mainNotifications, 0u);
+        NSDictionary *second = [controller timelinePreviewSnapshot];
+        XCTAssertEqualObjects(first[@"url"], second[@"url"]);
+        XCTAssertGreaterThan([second[@"sourceEpoch"] unsignedLongLongValue],
+                             [first[@"sourceEpoch"] unsignedLongLongValue]);
+        XCTAssertEqualObjects(first[@"sourceEpoch"], firstContext[@"sourceEpoch"]);
+        NSDictionary *secondContext = context.snapshot;
+        XCTAssertEqualObjects(second[@"sourceEpoch"], secondContext[@"sourceEpoch"]);
+        XCTAssertNotEqualObjects(firstContext[@"generation"], secondContext[@"generation"]);
+        XCTAssertFalse([secondContext[@"eligible"] boolValue]);
+        XCTAssertEqual(mainNotifications, 0u);
+
+        XCTestExpectation *drained = [self expectationWithDescription:@"actual controller media notifications drained"];
+        dispatch_async(dispatch_get_main_queue(), ^{ [drained fulfill]; });
+        [self waitForExpectations:@[drained] timeout:5];
+        XCTAssertEqual(mainNotifications, 2u);
+    } @finally {
+        /* Stop callback sources before draining queued main work, then delete the real player. */
+        [context invalidate];
+        if (controller)
+            [controller applicationWillTerminate:nil];
+        if (listener) {
