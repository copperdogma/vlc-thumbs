+- (void)advanceTimelineSourceEpoch
+{
+    /* vlc_player_cbs are synchronous and player-locked; do not dispatch this update. */
+    NSAssert(_timelineSourceEpoch < UINT64_MAX, @"Timeline source epoch exhausted");
+    _timelineSourceEpoch++;
+}
+
+- (NSDictionary *)timelinePreviewSnapshot
+{
+    NSString *uri = nil;
+    NSString *stableID = @"";
+    int inputID = -1;
+    size_t selectedCount = 0;
+    vlc_player_Lock(_p_player);
+    input_item_t *item = vlc_player_GetCurrentMedia(_p_player);
+    if (item) {
+        char *value = input_item_GetURI(item);
+        if (value)
+            uri = [[NSString alloc] initWithUTF8String:value];
+        free(value);
+    }
+    uint64_t sourceEpoch = _timelineSourceEpoch;
+    vlc_tick_t duration = vlc_player_GetLength(_p_player);
+    int capabilities = vlc_player_GetCapabilities(_p_player);
+    BOOL started = vlc_player_IsStarted(_p_player);
+    size_t count = vlc_player_GetTrackCount(_p_player, VIDEO_ES);
+    if (count <= 128) {
+        for (size_t index = 0; index < count; index++) {
+            const struct vlc_player_track *track = vlc_player_GetTrackAt(_p_player, VIDEO_ES, index);
+            if (!track->selected)
+                continue;
+            selectedCount++;
+            if (vlc_es_id_IsStrIdStable(track->es_id)) {
+                const char *value = vlc_es_id_GetStrId(track->es_id);
+                stableID = value ? [[NSString alloc] initWithUTF8String:value] : @"";
+                inputID = vlc_es_id_GetInputId(track->es_id);
+            }
+        }
+    }
+    vlc_player_Unlock(_p_player);
+
+    NSURL *url = uri ? [NSURL URLWithString:uri] : nil;
+    BOOL localURL = url.isFileURL && (!url.host.length || [url.host isEqualToString:@"localhost"]);
+    BOOL eligible = started && localURL && duration > 0 &&
+        (capabilities & VLC_PLAYER_CAP_SEEK) && count > 0 && count <= 128 &&
+        selectedCount == 1 && stableID.length > 0 && inputID >= 0;
+    NSMutableDictionary *snapshot = [@{
+        @"sourceEpoch": @(sourceEpoch),
+        @"duration": @(MAX(duration, 0)), @"eligible": @(eligible),
+        @"videoStableID": stableID ?: @"", @"videoInputID": @(inputID),
+        @"videoCount": @(count)
+    } mutableCopy];
+    if (url)
+        snapshot[@"url"] = url;
+    return [snapshot copy];
+}
