@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#import <XCTest/XCTest.h>
+#import "views/VLCPlaybackProgressSlider.h"
+
+@interface VLCTimelineHoverTest : XCTestCase
+@end
+@implementation VLCTimelineHoverTest
+- (void)testCenteredBandUsesBarAndClipsItsHorizontalRange
+{
+    NSRect band = VLCTimelineHoverRect(NSMakeRect(0, 0, 100, 20), NSMakeRect(6, 8, 88, 4));
+    XCTAssertEqualWithAccuracy(NSMidY(band), 10, 0.001);
+    XCTAssertEqualWithAccuracy(NSHeight(band), 32, 0.001);
+    XCTAssertEqualWithAccuracy(NSMinX(band), 6, 0.001);
+    XCTAssertEqualWithAccuracy(NSMaxX(band), 94, 0.001);
+    NSRect clipped = VLCTimelineHoverRect(NSMakeRect(0, 0, 100, 20), NSMakeRect(-10, 8, 120, 4));
+    XCTAssertEqualWithAccuracy(NSMinX(clipped), 0, 0.001);
+    XCTAssertEqualWithAccuracy(NSMaxX(clipped), 100, 0.001);
+}
+- (void)testPointerFractionUsesActualBarAndClampsEndpoints
+{
+    NSRect bar = NSMakeRect(6, 8, 88, 4);
+    XCTAssertEqual(VLCTimelinePreviewRequestTime(10000000, 10000000), 9999999);
+    XCTAssertEqual(VLCTimelinePreviewRequestTime(5000000, 10000000), 5000000);
+    XCTAssertEqual(VLCTimelinePreviewRequestTime(0, 1), 0);
+    XCTAssertEqual(VLCTimelinePreviewRequestTime(0, 0), 0);
+    XCTAssertEqualWithAccuracy(VLCTimelineHoverFraction(6, bar), 0, 0.001);
+    XCTAssertEqualWithAccuracy(VLCTimelineHoverFraction(50, bar), 0.5, 0.001);
+    XCTAssertEqualWithAccuracy(VLCTimelineHoverFraction(94, bar), 1, 0.001);
+    XCTAssertEqualWithAccuracy(VLCTimelineHoverFraction(-100, bar), 0, 0.001);
+    XCTAssertEqualWithAccuracy(VLCTimelineHoverFraction(200, bar), 1, 0.001);
+    XCTAssertEqualWithAccuracy(VLCTimelineHoverFraction(10, NSZeroRect), 0, 0.001);
+}
+- (void)testDelayedPresentationRequiresBothRequestAndContextGeneration
+{
+    XCTAssertTrue(VLCTimelinePreviewIsCurrent(7, 7, @"session:2", @"session:2"));
+    XCTAssertFalse(VLCTimelinePreviewIsCurrent(8, 7, @"session:2", @"session:2"));
+    XCTAssertFalse(VLCTimelinePreviewIsCurrent(7, 7, @"session:3", @"session:2"));
+    XCTAssertFalse(VLCTimelinePreviewIsCurrent(7, 7, nil, nil));
+}
+@end
