+/* This class-scoped fixture owns its process-environment mutations. Keep byte
+ * copies so an absent value and an explicitly empty value remain distinct. */
+static const char * const sEnvironmentNames[] = {
+    "VLC_USERDATA_PATH", "VLC_PLUGIN_PATH", "VLC_LIB_PATH", "VLC_LIBEXEC_PATH"
+};
+static char *sOriginalEnvironment[ARRAY_SIZE(sEnvironmentNames)];
+static BOOL sEnvironmentSaved;
+
+static BOOL SaveIntegrationEnvironment(void)
+{
+    if (sEnvironmentSaved)
+        return NO;
+    for (size_t i = 0; i < ARRAY_SIZE(sEnvironmentNames); ++i) {
+        const char *value = getenv(sEnvironmentNames[i]);
+        if (value != NULL) {
+            sOriginalEnvironment[i] = strdup(value);
+            if (sOriginalEnvironment[i] == NULL) {
+                for (size_t j = 0; j < i; ++j) {
+                    free(sOriginalEnvironment[j]);
+                    sOriginalEnvironment[j] = NULL;
+                }
+                return NO; /* No environment mutation has happened yet. */
+            }
+        }
+    }
+    sEnvironmentSaved = YES;
+    return YES;
+}
+
+static void RestoreIntegrationEnvironment(void)
+{
+    if (!sEnvironmentSaved)
+        return;
+    for (size_t i = 0; i < ARRAY_SIZE(sEnvironmentNames); ++i) {
+        if (sOriginalEnvironment[i] != NULL)
+            setenv(sEnvironmentNames[i], sOriginalEnvironment[i], 1);
+        else
+            unsetenv(sEnvironmentNames[i]);
+        free(sOriginalEnvironment[i]);
+        sOriginalEnvironment[i] = NULL;
+    }
+    sEnvironmentSaved = NO;
+}
