@@ -0,0 +1,218 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Bounded protocol/identity regressions. Media fixtures are generated separately.
+
+Basic mode needs only the built helper. --fixtures adds the documented legal
+standard/edit/trim/rotation/SAR suite; --identity-fixtures adds TrackNumber cases.
+Every helper runs in a dedicated POSIX process group with an independent timeout.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import signal
+import struct
+import subprocess
+import tempfile
+import time
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--helper', type=Path, required=True)
+parser.add_argument('--fixtures', type=Path)
+parser.add_argument('--trim-fixtures', type=Path)
+parser.add_argument('--identity-fixtures', type=Path)
+parser.add_argument('--admission-fixtures', type=Path)
+args = parser.parse_args()
+helper = args.helper.resolve(strict=True)
+checks = []
+
+
+def run(name, arguments, request=b'', success=True):
+    process = subprocess.Popen([str(helper), *map(str, arguments)], stdin=subprocess.PIPE,
+                               stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                               start_new_session=True)
+    started = time.monotonic()
+    try:
+        output, errors = process.communicate(request, timeout=20)
+    finally:
+        try:
+            os.killpg(process.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+        process.wait(timeout=2)
+    members = subprocess.run(['ps', '-axo', 'pid=,pgid=,stat='], capture_output=True,
+                             text=True, check=True, timeout=2)
+    assert not any(int(fields[1]) == process.pid for line in members.stdout.splitlines()
+                   if len(fields := line.split()) >= 3), 'Live process-group member'
+    assert (process.returncode == 0) == success, (name, process.returncode, errors)
+    # These tests request at most three bounded images, never unbounded output.
+    assert len(output) <= 3 * (320 * 180 * 4 + 4097) + 8194
+    replies = []
+    while output:
+        header, newline, output = output.partition(b'\n')
+        assert newline and len(header) <= 4096, name
+        reply = json.loads(header)
+        assert reply['version'] == 4 and type(reply['ok']) is bool
+        size = reply.get('payload_bytes', 0)
+        assert type(size) is int and 0 <= size <= 320 * 180 * 4 and len(output) >= size
+        pixels, output = output[:size], output[size:]
+        if size:
+            assert reply['ok'] and reply['channels'] == 4
+            assert size == reply['width'] * reply['height'] * 4
+        else:
+            assert not reply.get('width'), name
+        replies.append((reply, pixels))
+    assert replies, name
+    checks.append({'case': name, 'returncode': process.returncode, 'elapsed_seconds': time.monotonic() - started,
+                   'replies': [dict(reply, pixel_sha256=hashlib.sha256(pixels).hexdigest()
+                                    if pixels else None) for reply, pixels in replies]})
+    return replies
+
+
+def argv(path, input_id=1, count=1, worker=True):
+    result = ['--worker'] if worker else ['--time-us', '125000']
+    return result + ['--input', str(path.resolve()), '--video-input-id', str(input_id),
+                     '--video-count', str(count), '--max-width', '320', '--max-height', '180']
+
+
+def identity(reply, input_id, count, matroska):
+    assert reply['video_input_id'] == input_id and reply['video_count'] == count
+    assert reply['mapping'] == ('matroska-track-number-flat-v1' if matroska else 'single')
+    assert reply['video_track_number'] == (input_id if matroska else -1)
+
+
+def worker_success(replies, request_ids):
+    """Require one ready header and exactly one image for each request, in order."""
+    assert len(replies) == len(request_ids) + 1, 'Unexpected worker reply count'
+    ready, pixels = replies[0]
+    assert ready['type'] == 'ready' and ready['ok'] and not pixels
+    assert ready['duration_us'] > 0
+    for (reply, pixels), request_id in zip(replies[1:], request_ids):
+        assert type(reply['id']) is int and reply['id'] == request_id, 'Unexpected request ID'
+        assert reply['ok'] and pixels, 'Expected successful image reply'
+
+
+with tempfile.TemporaryDirectory(prefix='vlc-timeline-test-') as temporary:
+    path = Path(temporary) / 'data'
+    path.write_bytes(bytes(range(256)) * 8192)
+    # Required flags and numeric range checks run before any decoder is opened.
+    bad = [[], ['--worker'], argv(path, -1), argv(path, 2**31), argv(path, 1, 0),
+           argv(path, 1, 129), argv(path) + ['--unknown', '1'],
+           [item if item != '--video-input-id' else '--video-ordinal' for item in argv(path)]]
+    for index, arguments in enumerate(bad):
+        replies = run('invalid-arguments-%d' % index, arguments, success=False)
+        assert replies[-1][0]['error'] == 'invalid_arguments'
+    data = path.read_bytes()
+    for policy in ['stat', 'full', 'sampled']:
+        reply = run('fingerprint-' + policy,
+                    ['--fingerprint', policy, '--input', path])[0][0]
+        assert reply['type'] == 'identity' and reply['policy'] == policy and reply['ok']
+        if policy == 'full':
+            assert reply['fingerprint'] == hashlib.sha256(data).hexdigest()
+        elif policy == 'sampled':
+            digest = hashlib.sha256(b'vlc-thumbnail-sampled-v1\0')
+            for window in range(16):
+                offset = (len(data) - 65536) * window // 15
+                digest.update(struct.pack('>QQ', offset, 65536))
+                digest.update(data[offset:offset + 65536])
+            assert reply['fingerprint'] == digest.hexdigest()
+            assert reply['bytes_read'] == 16 * 65536
+        else:
+            assert reply['bytes_read'] == 0
+    path.write_bytes(data[:4096])
+    reply = run('fingerprint-small', ['--fingerprint', 'sampled', '--input', path])[0][0]
+    assert reply['fingerprint'] == hashlib.sha256(data[:4096]).hexdigest()
+    assert reply['bytes_read'] == 4096
+    run('missing-source', ['--fingerprint', 'sampled', '--input', path.with_name('missing')],
+        success=False)
+
+if args.fixtures:
+    fixtures = args.fixtures.resolve(strict=True)
+    for name, input_id, matroska in [('standard.mp4', 0, False),
+                                     ('positive-start.mkv', 1, True),
+                                     ('edit-offset.mp4', 0, False),
+                                     ('rotation.mp4', 0, False), ('sar.mp4', 0, False)]:
+        replies = run(name, argv(fixtures / name, input_id), b'1 125000\n2 4125000\n3 125000\n')
+        worker_success(replies, (1, 2, 3))
+        for reply, pixels in replies:
+            identity(reply, input_id, 1, matroska)
+            assert reply['ok'] and reply['open_count'] == 1
+            if pixels:
+                assert reply['actual_us'] >= 0 and reply['sampling'] == 'keyframe'
+        assert replies[1][1] == replies[3][1], 'Backward request changed same sample'
+        if name == 'edit-offset.mp4':
+            assert all(reply['timeline_origin_us'] == 0 and reply['actual_us'] == 2000000
+                       for reply, pixels in replies if pixels)
+        elif name == 'rotation.mp4':
+            assert (replies[1][0]['width'], replies[1][0]['height']) == (101, 180)
+        elif name == 'sar.mp4':
+            assert (replies[1][0]['width'], replies[1][0]['height']) == (320, 90)
+    for text in [b'1 -1\n', b'1  0\n', b'1 0', b'1 0\0\n', b'9' * 97 + b'\n']:
+        replies = run('malformed-request-' + text.hex(), argv(fixtures / 'standard.mp4', 0),
+                      text, success=False)
+        assert replies[-1][0]['error'] == 'invalid_request'
+        identity(replies[-1][0], 0, 1, False)
+    replies = run('one-shot', argv(fixtures / 'standard.mp4', 0, worker=False))
+    identity(replies[0][0], 0, 1, False)
+    assert replies[0][1] and replies[0][0]['open_count'] == 1
+    for input_id, color in [(1, 0), (2, 2)]:
+        replies = run('selected-%d' % input_id, argv(fixtures / 'two-tracks.mkv', input_id, 2),
+                      b'1 125000\n')
+        identity(replies[-1][0], input_id, 2, True)
+        rgb = replies[-1][1][:3]
+        assert rgb[color] > 200 and rgb[2 - color] < 30
+    for input_id, count, error in [(3, 2, 'track_unavailable'), (1, 1, 'ambiguous_track_mapping')]:
+        replies = run('rejected-selection-%d-%d' % (input_id, count),
+                      argv(fixtures / 'two-tracks.mkv', input_id, count), success=False)
+        assert replies[-1][0]['error'] == error
+
+if args.trim_fixtures:
+    for name in ['nonkeyframe-trim.mp4', 'negative-ctts-trim.mp4', 'negative-ctts.mp4']:
+        replies = run(name, argv(args.trim_fixtures / name, 0), b'1 0\n2 4125000\n3 0\n')
+        worker_success(replies, (1, 2, 3))
+        for reply, pixels in replies:
+            identity(reply, 0, 1, False)
+        for reply, pixels in replies[1:]:
+            assert reply['timeline_origin_us'] == 0
+            assert reply['actual_us'] == (0 if name == 'negative-ctts.mp4' else 6750000)
+
+if args.identity_fixtures:
+    # Fixture manifest's cases are validated externally; filenames are explicit.
+    fixtures = args.identity_fixtures.resolve(strict=True)
+    for name in ['nonconsecutive.mkv', 'reordered.mkv']:
+        assert (fixtures / name).is_file(), name
+        for input_id, channel in [(7, 0), (31, 2)]:
+            replies = run(name + '-%d' % input_id, argv(fixtures / name, input_id, 2), b'1 0\n')
+            identity(replies[-1][0], input_id, 2, True)
+            assert replies[-1][1][channel] > 200
+    replies = run('int-max', argv(fixtures / 'int-max.mkv', 2147483647, 2), b'1 0\n')
+    identity(replies[-1][0], 2147483647, 2, True)
+    assert replies[-1][1][2] > 200
+    for name in ['too-large.mkv', 'duplicate.mkv', 'zero.mkv']:
+        replies = run(name, argv(fixtures / name, 7, 2), b'1 0\n', success=False)
+        assert not any(pixels for reply, pixels in replies)
+        assert replies[-1][0]['error'] in ('ambiguous_track_mapping', 'unsupported_input')
+if args.admission_fixtures:
+    fixtures = args.admission_fixtures.resolve(strict=True)
+    manifest = json.loads((fixtures / 'manifest.json').read_text())
+    for case in manifest['cases']:
+        path = fixtures / case['file']
+        assert path.is_file() and path.resolve().is_relative_to(fixtures), case['file']
+        replies = run('admission-' + case['file'], argv(path, 1), b'1 0\n2 125000\n3 0\n',
+                      success=case['admitted'])
+        if case['admitted']:
+            worker_success(replies, (1, 2, 3))
+            for reply, pixels in replies:
+                identity(reply, 1, 1, True)
+                assert reply['ok'] and reply['open_count'] == 1
+                assert 0 <= reply['flat_scan_bytes'] <= 8 * 1024 * 1024
+                assert 0 < reply['flat_scan_reads']
+                assert 0 < reply['flat_scan_seeks'] <= 20000
+                assert 0 < reply['flat_scan_nodes'] <= 100000
+            assert replies[1][1] == replies[3][1], 'Admission changed buffered decoder state'
+            # Measured counters are recorded; do not assert an unqualified NAS budget.
+        else:
+            assert not any(pixels for reply, pixels in replies)
+            assert not any(reply.get('type') == 'ready' for reply, pixels in replies)
+print(json.dumps({'checks': checks, 'count': len(checks), 'pass': True}, indent=2))
