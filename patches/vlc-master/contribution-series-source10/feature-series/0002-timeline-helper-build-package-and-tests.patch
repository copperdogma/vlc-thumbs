+++ b/bin/timeline-preview/test-io.c
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Actual libavformat custom-AVIO admission regression, not a parser substitute.
+ * Use the independently generated flat-two-hours-1200-clusters.mkv fixture.
+ */
+#include <assert.h>
+#include <errno.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <libavformat/avformat.h>
+#include <libavutil/opt.h>
+#include <libavutil/sha.h>
+
+typedef struct {
+    const uint8_t *data;
+    int64_t size, cursor, segment_start, saved_cursor;
+    int mode, scanning, injected, restore_attempts;
+} Source;
+
+static int read_memory(void *opaque, uint8_t *buffer, int size)
+{
+    Source *source = opaque;
+    if (source->mode == 3 && source->scanning && !source->injected) {
+        source->injected = 1;
+        return AVERROR(EIO);
+    }
+    if (source->cursor == source->size) return AVERROR_EOF;
+    int64_t left = source->size - source->cursor;
+    if (size > left) size = (int)left;
+    memcpy(buffer, source->data + source->cursor, size);
+    source->cursor += size;
+    return size;
+}
+
+static int64_t seek_memory(void *opaque, int64_t offset, int whence)
+{
+    Source *source = opaque;
+    if (whence == AVSEEK_SIZE)
+        return source->mode == 1 ? AVERROR(ENOSYS) : source->size;
+    if (whence == SEEK_END) offset += source->size;
+    else if (whence == SEEK_CUR) offset += source->cursor;
+    else if (whence != SEEK_SET) return AVERROR(EINVAL);
+    if (offset < 0 || offset > source->size) return AVERROR(EINVAL);
+    if (!source->scanning && offset == source->segment_start) {
+        source->scanning = 1;
+        source->saved_cursor = source->cursor;
+    } else if (source->scanning && offset == source->saved_cursor &&
+               (source->cursor == source->size || source->injected)) {
+        source->restore_attempts++;
+        source->scanning = 0;
+        if (source->mode == 2) {
+            source->injected = 1;
+            source->cursor = 0; /* Prove restore failure cannot certify admission. */
+            return AVERROR(EIO);
+        }
+    }
+    source->cursor = offset;
+    return offset;
+}
+
+static int acquire(const uint8_t *data, int64_t size, int64_t segment_start,
+                   int flat, int mode, uint8_t digest[32])
+{
+    Source source = { .data = data, .size = size, .segment_start = segment_start, .mode = mode };
+    uint8_t *buffer = av_malloc(32768);
+    AVIOContext *io = avio_alloc_context(buffer, 32768, 0, &source, read_memory, NULL, seek_memory);
+    AVFormatContext *format = avformat_alloc_context();
+    assert(buffer && io && format);
+    format->pb = io;
+    format->flags |= AVFMT_FLAG_CUSTOM_IO;
+    AVDictionary *options = NULL;
+    av_dict_set(&options, "flat_timeline", flat ? "1" : "0", 0);
+    int ret = avformat_open_input(&format, NULL, av_find_input_format("matroska"), &options);
+    int64_t checked = 0;
+    if (ret >= 0) {
+        assert(!av_dict_get(options, "flat_timeline", NULL, 0));
+        assert(av_opt_get_int(format->priv_data, "flat_timeline_checked", 0, &checked) >= 0);
+    }
+    av_dict_free(&options);
+    if (mode) {
+        assert(ret < 0 && checked == 0);
+        if (mode == 2 || mode == 3)
+            assert(source.injected && source.restore_attempts == 1);
+    } else {
+        assert(ret >= 0 && checked == flat);
+        if (flat) assert(source.restore_attempts == 1);
+        assert(avformat_find_stream_info(format, NULL) >= 0);
+        AVPacket *packet = av_packet_alloc();
+        struct AVSHA *sha = av_sha_alloc();
+        assert(packet && sha && av_sha_init(sha, 256) == 0);
+        int count = 0;
+        while ((ret = av_read_frame(format, packet)) >= 0) {
+            av_sha_update(sha, packet->data, packet->size);
+            count++;
+            av_packet_unref(packet);
+        }
+        assert(ret == AVERROR_EOF && count == 1200);
+        av_sha_final(sha, digest);
+        av_free(sha);
+        av_packet_free(&packet);
+    }
+    printf("mode=%d flat=%d result=%d checked=%" PRId64 " injected=%d restore_attempts=%d\n",
+           mode, flat, ret, checked, source.injected, source.restore_attempts);
+    avformat_close_input(&format);
+    av_freep(&io->buffer);
+    avio_context_free(&io);
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 3); /* fixture path and its independent root Segment data offset */
+    alarm(15); /* Independent outer launcher must also kill/reap the process group. */
+    char *end;
+    errno = 0;
+    int64_t segment_start = strtoll(argv[2], &end, 10);
+    assert(!errno && !*end && segment_start > 0);
+    FILE *file = fopen(argv[1], "rb");
+    assert(file && fseek(file, 0, SEEK_END) == 0);
+    long size = ftell(file);
+    assert(size > segment_start && size <= 2 * 1024 * 1024);
+    rewind(file);
+    uint8_t *data = av_malloc(size);
+    assert(data && fread(data, 1, size, file) == (size_t)size);
+    assert(fclose(file) == 0);
+    uint8_t plain[32], admitted[32];
+    av_log_set_level(AV_LOG_QUIET);
+    acquire(data, size, segment_start, 0, 0, plain);
+    acquire(data, size, segment_start, 1, 0, admitted);
+    assert(memcmp(plain, admitted, 32) == 0);
+    for (int mode = 1; mode <= 3; mode++)
+        acquire(data, size, segment_start, 1, mode, admitted);
+    av_free(data);
+    puts("PASS: same full packet stream; size/restore/read failures fail closed");
+    return 0;
+}
