@@ -0,0 +1,412 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Generate small synthetic Matroska flat-timeline admission controls.
+
+Standalone Python 3.8+ standard library and FFmpeg/libx264 plus ffprobe. Only one
+generated red AVC keyframe is encoded; repeated IDR payloads and new timestamps
+make the 1200-Cluster/two-hour scan-cost case under 2 MiB. This is test-container
+construction, never a production parser. A structural oracle checks the emitted
+tree independently of the admission demux option. FFprobe compatibility is an
+observation, not an ordered/link eligibility oracle or complete spec validator.
+
+Examples:
+  python3 generate_admission_fixtures.py --output /new/scratch/admission
+  python3 ../test.py --helper /built/vlc-timeline-preview --admission-fixtures /new/scratch/admission
+
+Sources: https://www.matroska.org/technical/elements.html
+         https://www.matroska.org/technical/chapters.html
+         https://www.matroska.org/technical/notes.html
+         https://www.rfc-editor.org/rfc/rfc8794.html (unknown-size/document boundaries)
+EBML writer primitives follow the neighboring LGPL generate_dependency_fixtures.py
+and are included here so the generator works when copied by itself.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+
+
+EBML, SEGMENT, INFO, TRACKS, CLUSTER = 0x1A45DFA3, 0x18538067, 0x1549A966, 0x1654AE6B, 0x1F43B675
+CHAPTERS, EDITION, ATOM, ORDERED = 0x1043A770, 0x45B9, 0xB6, 0x45DD
+SEEKHEAD, SEEK, SEEKID, SEEKPOS = 0x114D9B74, 0x4DBB, 0x53AB, 0x53AC
+UID, PREV, NEXT, FAMILY, CHAPTER_LINK, EDITION_LINK = 0x73A4, 0x3CB923, 0x3EB923, 0x4444, 0x6E67, 0x6EBC
+OWN_UID = bytes.fromhex('102030405060708090a0b0c0d0e0f001')
+LINK_UID = bytes.fromhex('112233445566778899aabbccddeeff01')
+MASTER_IDS = {EBML, SEGMENT, INFO, TRACKS, 0xAE, 0xE0, 0xE1, CLUSTER,
+              0xA0, CHAPTERS, EDITION, ATOM, SEEKHEAD, SEEK,
+              0x1254C367, 0x7373, 0x63C0, 0x67C8}
+MAX_FILE = 2 * 1024 * 1024
+MAX_TOTAL = 16 * 1024 * 1024
+RESERVE = 1024 ** 3
+
+
+def id_bytes(ident):
+    return ident.to_bytes((ident.bit_length() + 7) // 8, 'big')
+
+
+def encode_vint(value, width=None):
+    for count in ([width] if width else range(1, 9)):
+        if 0 <= value < (1 << (7 * count)) - 1:
+            return ((1 << (7 * count)) | value).to_bytes(count, 'big')
+    raise ValueError('VINT overflow')
+
+
+def element(ident, body):
+    return id_bytes(ident) + encode_vint(len(body)) + body
+
+
+def uint(ident, value, width=None):
+    count = width or max(1, (value.bit_length() + 7) // 8)
+    return element(ident, value.to_bytes(count, 'big'))
+
+
+def unknown(ident, body):
+    return id_bytes(ident) + b'\x01' + b'\xff' * 7 + body
+
+
+def read_vint(data, at, ident=False):
+    if at >= len(data) or data[at] == 0:
+        raise ValueError('missing/zero VINT marker')
+    width = 1
+    while not data[at] & (1 << (8 - width)):
+        width += 1
+    if width > (4 if ident else 8) or at + width > len(data):
+        raise ValueError('invalid/truncated VINT')
+    raw = int.from_bytes(data[at:at + width], 'big')
+    value = raw if ident else raw & ((1 << (7 * width)) - 1)
+    return value, width, not ident and value == (1 << (7 * width)) - 1
+
+
+def parse(data, start=0, stop=None):
+    """Return bounded element extents; unknown size consumes the bounded parent."""
+    stop = len(data) if stop is None else stop
+    nodes = []
+    at = start
+    while at < stop:
+        ident, first, _ = read_vint(data, at, True)
+        length, second, unbounded = read_vint(data, at + first)
+        begin = at + first + second
+        end = stop if unbounded else begin + length
+        if begin > stop or end > stop or end <= at:
+            raise ValueError('element exceeds parent/file or makes no progress')
+        nodes.append({'id': ident, 'at': at, 'begin': begin, 'end': end,
+                      'unknown': unbounded})
+        at = end
+    return nodes
+
+
+def children(data, parent):
+    return parse(data, parent['begin'], parent['end'])
+
+
+def body(data, node):
+    return data[node['begin']:node['end']]
+
+
+def chapter(uid=1, nested=False, linked=False, edition_link=False):
+    fields = uint(0x73C4, uid) + uint(0x91, 0) + uint(0x92, 6000000000)
+    if linked:
+        fields += element(CHAPTER_LINK, LINK_UID)
+    if edition_link:
+        fields += uint(EDITION_LINK, 7)
+    if nested:
+        fields += chapter(uid + 1, linked=True)
+    return element(ATOM, fields)
+
+
+def edition(uid, flags=None, hidden=False, linked=False, nested=False, edition_link=False):
+    fields = uint(0x45BC, uid)
+    if hidden:
+        fields += uint(0x45BD, 1) + uint(0x45DB, 0)
+    for flag in flags or []:
+        fields += uint(ORDERED, flag)
+    return element(EDITION, fields + chapter(uid * 10, nested, linked, edition_link))
+
+
+def chapters(*editions):
+    return element(CHAPTERS, b''.join(editions))
+
+
+def fake_tags(value):
+    fields = []
+    for name in ['flat_timeline_checked', 'flat_timeline', 'TIMELINE_PREVIEW_ADMITTED']:
+        fields.append(element(0x67C8, element(0x45A3, name.encode('ascii')) +
+                              element(0x4487, value.encode('ascii'))))
+    return element(0x1254C367, element(0x7373, element(0x63C0, b'') + b''.join(fields)))
+
+
+def information(extra=b'', duration_ms=6000):
+    return element(INFO, element(UID, OWN_UID) + uint(0x2AD7B1, 1000000) +
+                   element(0x4489, struct.pack('>d', float(duration_ms))) +
+                   element(0x4D80, b'VLC synthetic admission fixtures 1') +
+                   element(0x5741, b'VLC synthetic admission fixtures 1') + extra)
+
+
+def seek_head(entries):
+    return element(SEEKHEAD, b''.join(element(SEEK, element(SEEKID, id_bytes(ident)) +
+                                            uint(SEEKPOS, position, 4))
+                                    for ident, position in entries))
+
+
+def assemble(header, parts, index=None, unbounded=False):
+    """Index positions are relative to Segment data; fixed-width avoids iteration."""
+    if index:
+        dummy = seek_head([(ident, 0) for ident in index])
+        positions = {}
+        at = len(dummy)
+        for ident, data in parts:
+            positions.setdefault(ident, at)
+            at += len(data)
+        entries = [(ident, positions[ident]) for ident in index]
+        if index == [CHAPTERS, INFO]:  # deliberately invalid seek position
+            entries[0] = (CHAPTERS, at + 4096)
+        prefix = seek_head(entries)
+        assert len(prefix) == len(dummy)
+    else:
+        prefix = b''
+    content = prefix + b''.join(data for _, data in parts)
+    return header + (unknown(SEGMENT, content) if unbounded else element(SEGMENT, content))
+
+
+def structural_oracle(data):
+    """Observe tree facts, not production-gate behavior or complete Matroska validity."""
+    facts = {'complete_bounds': True, 'segments': 0, 'cluster_count': 0,
+             'unknown_clusters': 0, 'ordered_flags': [], 'link_ids': [],
+             'own_segment_uids': [], 'chapter_offsets': [], 'first_cluster_offset': None,
+             'cluster_timestamps_ms': [], 'seek_entries': [], 'nodes': 0,
+             'segment_elements': 0, 'ebml_headers': 0,
+             'root_boundary_ids_within_unknown_segment': []}
+    try:
+        roots = parse(data)
+        segments = [n for n in roots if n['id'] == SEGMENT]
+        facts['segments'] = len(segments)
+        def walk(nodes, ancestry=(), unknown_segment=False):
+            for node in nodes:
+                facts['nodes'] += 1
+                ident, payload = node['id'], body(data, node)
+                if ident == SEGMENT:
+                    facts['segment_elements'] += 1
+                if ident == EBML:
+                    facts['ebml_headers'] += 1
+                if unknown_segment and ident in (SEGMENT, EBML):
+                    # The extent walker bounds unknown size to EOF, but RFC8794
+                    # schema levels terminate it at a new root/header boundary.
+                    # Report these explicitly; do not mislabel them child metadata.
+                    facts['root_boundary_ids_within_unknown_segment'].append(
+                        {'id': hex(ident), 'offset': node['at'], 'unknown': node['unknown']})
+                if ident == CLUSTER:
+                    facts['cluster_count'] += 1
+                    facts['unknown_clusters'] += int(node['unknown'])
+                    if facts['first_cluster_offset'] is None:
+                        facts['first_cluster_offset'] = node['at']
+                if ident == CHAPTERS:
+                    facts['chapter_offsets'].append(node['at'])
+                if ident == ORDERED and EDITION in ancestry:
+                    facts['ordered_flags'].append(int.from_bytes(payload, 'big'))
+                if ident in (PREV, NEXT, FAMILY, CHAPTER_LINK, EDITION_LINK):
+                    facts['link_ids'].append(hex(ident))
+                if ident == UID:
+                    facts['own_segment_uids'].append(payload.hex())
+                if ident == 0xE7 and CLUSTER in ancestry:
+                    facts['cluster_timestamps_ms'].append(int.from_bytes(payload, 'big'))
+                if ident == SEEK:
+                    fields = {c['id']: body(data, c) for c in children(data, node)}
+                    target = int.from_bytes(fields[SEEKID], 'big')
+                    position = int.from_bytes(fields[SEEKPOS], 'big')
+                    segment = next(s for s in segments if s['begin'] <= node['at'] < s['end'])
+                    absolute = segment['begin'] + position
+                    top = {c['at']: c['id'] for c in children(data, segment)}
+                    facts['seek_entries'].append({'target': hex(target), 'position': position,
+                                                   'matches': top.get(absolute) == target})
+                if ident in MASTER_IDS:
+                    walk(children(data, node), ancestry + (ident,),
+                         unknown_segment or (ident == SEGMENT and node['unknown']))
+        walk(roots)
+    except (ValueError, KeyError, StopIteration) as error:
+        facts['complete_bounds'] = False
+        facts['error'] = str(error)
+    return facts
+
+
+def main():
