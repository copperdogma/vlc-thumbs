+#!/usr/bin/env python3
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Generate a new, bounded directory of synthetic VLC preview diagnostics.
+
+Python 3.9+ standard library; external FFmpeg/ffprobe with libx264 are required.
+No video, font, network input, VLC library, or machine-specific path is used.
+"""
+import argparse
+from contextlib import nullcontext
+import hashlib
+import json
+import os
+import shutil
+import signal
+import subprocess
+import struct
+import time
+from pathlib import Path
+
+LIMIT = 300 * 1024 * 1024
+RESERVE = 1024 ** 3
+DURATION = 12
+RATE = 24
+LONG_FILE_LIMIT = 25 * 1024 * 1024
+LONG_TOTAL_LIMIT = 60 * 1024 * 1024
+PLAYBACK_FILE_LIMIT = 400 * 1024 * 1024
+PLAYBACK_TOTAL_LIMIT = 460 * 1024 * 1024
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with path.open('rb') as source:
+        for block in iter(lambda: source.read(1024 * 1024), b''):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+CONTAINERS = {b'moov', b'trak', b'mdia', b'minf', b'stbl', b'edts'}
+
+def boxes(data):
+    result = []
+    offset = 0
+    while offset < len(data):
+        if len(data) - offset < 8:
+            raise ValueError('trailing box bytes')
+        size, kind = struct.unpack_from('>I4s', data, offset)
+        if size < 8 or offset + size > len(data):
+            raise ValueError('unsupported box bounds')
+        body = data[offset + 8:offset + size]
+        result.append([kind, boxes(body) if kind in CONTAINERS else body])
+        offset += size
+    return result
+
+def encode(nodes):
+    output = b''
+    for kind, body in nodes:
+        body = encode(body) if isinstance(body, list) else body
+        output += struct.pack('>I4s', len(body) + 8, kind) + body
+    return output
+
+def find(nodes, kind):
+    return next((node for node in nodes if node[0] == kind))
+
+def duration(node, value):
+    kind, body = node
+    if body[0] != 0:
+        raise ValueError('fixture requires version-zero timing headers')
+    offset = 20 if kind == b'tkhd' else 16
+    body = bytearray(body)
+    struct.pack_into('>I', body, offset, value)
+    node[1] = bytes(body)
+
+def edit(source, destination, segments):
+    tree = boxes(source.read_bytes())
+    kinds = [node[0] for node in tree]
+    # The rebuilt moov follows mdat, preserving existing chunk offsets.
+    if kinds.index(b'moov') < kinds.index(b'mdat'):
+        raise ValueError('moov must follow mdat')
+    moov = find(tree, b'moov')[1]
+    trak = find(moov, b'trak')[1]
+    movie_scale = struct.unpack_from('>I', find(moov, b'mvhd')[1], 12)[0]
+    media_scale = struct.unpack_from('>I', find(find(trak, b'mdia')[1], b'mdhd')[1], 12)[0]
+    edts = next((n for n in trak if n[0] == b'edts'), None)
+    if edts is None:
+        edts = [b'edts', []]
+        trak.append(edts)
+    elst = next((n for n in edts[1] if n[0] == b'elst'), None)
+    origin = 0
+    if elst:
+        if elst[1][0] != 0:
+            raise ValueError('fixture requires version-zero edit')
+        count = struct.unpack_from('>I', elst[1], 4)[0]
+        if count != 1:
+            raise ValueError('base must have at most one edit')
+        origin = struct.unpack_from('>i', elst[1], 12)[0]
+        if origin < 0:
+            raise ValueError('base edit must be nonempty')
+    else:
+        elst = [b'elst', b'']
+        edts[1].append(elst)
+    entries = []
+    for start, length, rate in segments:
+        entries.append((round(length * movie_scale), origin + round(start * media_scale), rate, 0))
+    elst[1] = b'\x00\x00\x00\x00' + struct.pack('>I', len(entries)) + b''.join((struct.pack('>Iihh', *entry) for entry in entries))
+    total = sum((entry[0] for entry in entries))
+    duration(find(moov, b'mvhd'), total)
+    duration(find(trak, b'tkhd'), total)
+    destination.write_bytes(encode(tree))
+    return {'movie_timescale': movie_scale, 'media_timescale': media_scale, 'base_edit_media_time': origin, 'entries': entries, 'segments_source_seconds': segments}
+
+
+def long_fixture(args, out, versions):
+    """Optional larger-byte layout; never substitutes for a historical fixture."""
+    from generate_admission_fixtures import structural_oracle
+    commands = []
+    minimum_free = shutil.disk_usage(out).free
+
+    def guard():
+        nonlocal minimum_free
+        minimum_free = min(minimum_free, shutil.disk_usage(out).free)
+        size = sum(p.stat().st_size for p in out.iterdir() if p.is_file())
+        if minimum_free < RESERVE or size > LONG_TOTAL_LIMIT:
+            raise RuntimeError('Long fixture output/reserve bound reached')
+
+    def run(tool, argv, output=None):
+        guard()
+        commands.append({'tool': tool, 'argv': argv, 'stdout': output})
+        with (out / output).open('xb') if output else nullcontext(subprocess.DEVNULL) as target:
+            with (out / 'tool-stderr.log').open('ab') as errors:
+                process = subprocess.Popen([getattr(args, tool)] + argv, cwd=out,
+                                           stdout=target, stderr=errors, start_new_session=True)
+                started = time.monotonic()
+                try:
+                    while process.poll() is None:
+                        guard()
+                        if time.monotonic() - started > 120:
+                            raise RuntimeError('Long fixture tool exceeded120s')
+                        time.sleep(0.1)
+                    if process.returncode:
+                        raise RuntimeError('Long fixture tool failed; inspect tool-stderr.log')
+                finally:
+                    try:
+                        os.killpg(process.pid, signal.SIGKILL)
+                    except ProcessLookupError:
+                        pass
+                    process.wait(timeout=2)
+        guard()
+
+    base = ['-nostdin', '-hide_banner', '-loglevel', 'error', '-n']
+    encoder = ['-c:v', 'libx264', '-preset', 'veryfast', '-crf', '23',
+               '-pix_fmt', 'yuv420p', '-threads', '2', '-g', '48',
+               '-keyint_min', '48', '-sc_threshold', '0', '-bf', '3', '-b_strategy', '0']
+    run('ffmpeg', base + ['-f', 'lavfi', '-i', 'testsrc2=size=320x180:rate=24:duration=300',
+                         '-f', 'lavfi', '-i', 'sine=frequency=440:sample_rate=48000:duration=300',
+                         '-map', '0:v:0', '-map', '1:a:0'] + encoder +
+        ['-c:a', 'alac', '-movflags', '+faststart', '-fs', str(LONG_FILE_LIMIT), 'long-preparation.mp4'])
+    run('ffmpeg', base + ['-i', 'long-preparation.mp4', '-map', '0:v:0', '-an', '-c', 'copy',
+                         '-cluster_time_limit', '1000', '-fs', str(LONG_FILE_LIMIT),
+                         'long-preparation-clusters.mkv'])
+    records = []
+    for name in ['long-preparation.mp4', 'long-preparation-clusters.mkv']:
+        if (out / name).stat().st_size > LONG_FILE_LIMIT:
+            raise RuntimeError('Long fixture file exceeded25MiB')
+        run('ffprobe', ['-v', 'error', '-count_frames', '-show_streams', '-show_format',
+                        '-of', 'json', name], name + '.probe.json')
+        probe = json.loads((out / (name + '.probe.json')).read_text())
+        videos = [s for s in probe['streams'] if s['codec_type'] == 'video']
+        if len(videos) != 1 or int(videos[0]['nb_read_frames']) != 7200:
+            raise RuntimeError('Incomplete long video fixture')
+        if abs(float(probe['format']['duration']) - 300) > 0.05:
+            raise RuntimeError('Long fixture is not300seconds')
+        run('ffprobe', ['-v', 'error', '-select_streams', 'v:0', '-show_frames',
+                        '-show_entries', 'frame=pts_time,key_frame,pict_type', '-of', 'json', name],
+            name + '.frames.json')
+        frames = json.loads((out / (name + '.frames.json')).read_text())['frames']
+        keys = [float(frame['pts_time']) for frame in frames if frame['key_frame']]
+        if len(keys) != 150 or any(abs(stamp - index * 2) > 0.001 for index, stamp in enumerate(keys)):
+            raise RuntimeError('Long fixture two-second keyframe spacing missing')
+        records.append({'name': name, 'bytes': (out / name).stat().st_size,
+                        'sha256': sha256(out / name), 'probe': name + '.probe.json',
+                        'frames': name + '.frames.json', 'keyframe_pts_seconds': keys})
+    run('ffprobe', ['-v', 'error', '-select_streams', 'a:0', '-show_packets',
+                    '-show_entries', 'packet=pts_time,duration_time', '-of', 'json',
+                    'long-preparation.mp4'], 'audio-packets.json')
+    audio = json.loads((out / 'audio-packets.json').read_text())['packets']
+    end = 0.0
+    for packet in audio:
+        start = float(packet['pts_time'])
+        length = float(packet['duration_time'])
+        if abs(start - end) > 0.00001 or length <= 0:
+            raise RuntimeError('Discontinuous long audio packet timeline')
+        end = start + length
+    if abs(end - 300) > 0.00001:
+        raise RuntimeError('Incomplete long audio timeline')
+    facts = structural_oracle((out / 'long-preparation-clusters.mkv').read_bytes())
+    if not facts['complete_bounds'] or facts['segments'] != 1 or facts['unknown_clusters'] or not facts['cluster_count']:
+        raise RuntimeError('Long remux lacks complete finite-Cluster layout')
+    manifest = {'schema_version': 1, 'mode': 'optional-long-only',
+                'legal': 'Generated testsrc2 and sine; no fonts, imported media or historical seed.',
+                'generator_sha256': sha256(Path(__file__)), 'tools': versions,
+                'encoder': encoder, 'duration_seconds': 300, 'frame_rate': 24,
+                'audio': {'codec': 'alac', 'frequency_hz': 440, 'sample_rate': 48000,
+                          'packet_timeline_contiguous': True, 'timeline_end_seconds': end},
+                'commands': commands, 'fixtures': records, 'structural_oracle': facts,
+                'structural_oracle_source_sha256': sha256(Path(__file__).with_name('generate_admission_fixtures.py')),
+                'bounds': {'file_bytes': LONG_FILE_LIMIT, 'total_bytes': LONG_TOTAL_LIMIT,
+                           'reserve_bytes': RESERVE, 'tool_seconds': 120,
+                           'minimum_free_bytes': minimum_free},
+                'qualification': 'New representative larger-byte layout, not equivalent historical bytes/hash. '
+                                 'Muxer versions/random container IDs can change hashes and Cluster counts. '
+                                 'Packet timeline continuity is not audible playback or nativeUI proof.'}
+    (out / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
+    guard()
+    print(json.dumps({'mode': 'long-only', 'files': records,
+                      'finite_clusters': facts['cluster_count'], 'output': str(out)}))
+
+
+def playback_fixture(args, out, versions):
+    """Stream-copy the explicit five-minute generated source; never encode two hours."""
+    source = args.playback_loop_source.resolve(strict=True)
+    if not source.is_file() or source.stat().st_size > LONG_FILE_LIMIT:
+        raise RuntimeError('Playback input must be a <=25MiB generated source')
+    commands = []
+    minimum_free = shutil.disk_usage(out).free
+
+    def guard():
+        nonlocal minimum_free
+        minimum_free = min(minimum_free, shutil.disk_usage(out).free)
+        if minimum_free < RESERVE or sum(p.stat().st_size for p in out.iterdir()
+                                        if p.is_file()) > PLAYBACK_TOTAL_LIMIT:
+            raise RuntimeError('Playback output/reserve bound reached')
+
+    def run(tool, argv, output=None):
+        guard()
+        commands.append({'tool': tool, 'argv': argv, 'stdout': output})
+        with (out / output).open('xb') if output else nullcontext(subprocess.DEVNULL) as target:
+            with (out / 'tool-stderr.log').open('ab') as errors:
+                process = subprocess.Popen([getattr(args, tool)] + argv, cwd=out,
+                                           stdout=target, stderr=errors, start_new_session=True)
+                started = time.monotonic()
+                try:
+                    while process.poll() is None:
+                        guard()
+                        if time.monotonic() - started > 120:
+                            raise RuntimeError('Playback fixture tool exceeded120s')
+                        time.sleep(0.1)
+                    if process.returncode:
+                        raise RuntimeError('Playback fixture tool failed; inspect tool-stderr.log')
+                finally:
+                    try:
+                        os.killpg(process.pid, signal.SIGKILL)
+                    except ProcessLookupError:
+                        pass
+                    process.wait(timeout=2)
+        guard()
+
+    run('ffprobe', ['-v', 'error', '-show_streams', '-show_format', '-of', 'json',
+                    str(source)], 'source.probe.json')
+    original = json.loads((out / 'source.probe.json').read_text())
+    streams = original['streams']
+    if (len(streams) != 2 or streams[0]['codec_name'] != 'h264' or
+        streams[0]['r_frame_rate'] != '24/1' or streams[0]['width'] != 320 or
+        streams[0]['height'] != 180 or streams[0]['pix_fmt'] != 'yuv420p' or
+        streams[1]['codec_name'] != 'alac' or streams[1]['sample_rate'] != '48000' or
+        streams[1]['channels'] != 1 or
+        abs(float(original['format']['duration']) - 300) > 0.00001):
+        raise RuntimeError('Input does not match the generated300s source contract')
+    name = 'preparation-two-hours.mp4'
+    base = ['-nostdin', '-hide_banner', '-loglevel', 'error', '-n']
+    run('ffmpeg', base + ['-stream_loop', '23', '-i', str(source), '-map', '0:v:0',
+                         '-map', '0:a:0', '-c', 'copy', '-t', '7200', '-movflags',
+                         '+faststart', '-fs', str(PLAYBACK_FILE_LIMIT), name])
+    if (out / name).stat().st_size > PLAYBACK_FILE_LIMIT:
+        raise RuntimeError('Playback fixture exceeded400MiB')
+    run('ffprobe', ['-v', 'error', '-show_streams', '-show_format', '-of', 'json', name],
+        'playback.probe.json')
+    probe = json.loads((out / 'playback.probe.json').read_text())
+    if abs(float(probe['format']['duration']) - 7200) > 0.00001:
+        raise RuntimeError('Loop output is not7200seconds')
+    run('ffprobe', ['-v', 'error', '-show_packets', '-show_entries',
+                    'packet=stream_index,pts_time,dts_time,duration_time',
+                    '-of', 'compact=p=0:nk=0', name], 'packets.txt')
+    pts = []
+    video_dts = None
+    audio_end = 0.0
+    for line in (out / 'packets.txt').read_text().splitlines():
+        fields = dict(item.split('=', 1) for item in line.split('|') if '=' in item)
+        stamp = float(fields['pts_time'])
+        length = float(fields['duration_time'])
+        if fields['stream_index'] == '0':
+            dts = float(fields['dts_time'])
+            if video_dts is not None and abs(dts - video_dts - 1 / 24) > 0.000002:
+                raise RuntimeError('Video DTS discontinuity, including loop boundary')
+            video_dts = dts
+            pts.append(stamp)
+        elif fields['stream_index'] == '1':
+            if abs(stamp - audio_end) > 0.000002 or length <= 0:
+                raise RuntimeError('Audio packet discontinuity, including loop boundary')
+            audio_end = stamp + length
+        else:
+            raise RuntimeError('Unexpected playback stream')
+    if (len(pts) != 172800 or
+        any(abs(stamp - index / 24) > 0.000002 for index, stamp in enumerate(sorted(pts))) or
+        abs(audio_end - 7200) > 0.000002):
+        raise RuntimeError('Playback presentation timeline is incomplete')
+    run('ffmpeg', base + ['-i', name, '-map', '0:v:0', '-t', '60', '-an',
+                         '-pix_fmt', 'rgba', '-f', 'framehash', '-hash', 'sha256',
+                         'first-minute.framehash'])
+    hashes = [line.rsplit(',', 1)[-1].strip() for line in
+              (out / 'first-minute.framehash').read_text().splitlines()
+              if line and not line.startswith('#')]
+    if len(hashes) != 1440 or len(set(hashes)) < 100:
+        raise RuntimeError('First minute lacks ordinary moving24fps video')
+    run('ffmpeg', base + ['-i', name, '-map', '0:a:0', '-t', '60', '-vn',
+                         '-c:a', 'pcm_s16le', '-f', 's16le', 'first-minute.pcm'])
+    audio = (out / 'first-minute.pcm').read_bytes()
+    if len(audio) != 60 * 48000 * 2:
+        raise RuntimeError('First-minute decoded audio length mismatch')
+    rms = []
+    for second in range(60):
+        samples = struct.unpack('<48000h', audio[second * 96000:(second + 1) * 96000])
+        rms.append((sum(sample * sample for sample in samples) / 48000) ** .5)
+    if min(rms) < 100:
+        raise RuntimeError('First-minute decoded audio has a silent second')
+    manifest = {'schema_version': 1, 'mode': 'optional-playback-loop',
+                'generator_sha256': sha256(Path(__file__)), 'tools': versions,
+                'source': {'name': source.name, 'sha256': sha256(source),
+                           'bytes': source.stat().st_size}, 'commands': commands,
+                'fixture': {'name': name, 'sha256': sha256(out / name),
+                            'bytes': (out / name).stat().st_size},
+                'duration_seconds': 7200, 'loop_passes': 24, 'video_packets': len(pts),
+                'oracle': {'video_pts_grid_seconds': 'n/24', 'video_dts_contiguous': True,
+                           'audio_packet_end_seconds': audio_end,
+                           'first_minute_video_frames': len(hashes), 'audio_one_second_rms': rms},
+                'bounds': {'file_bytes': PLAYBACK_FILE_LIMIT, 'total_bytes': PLAYBACK_TOTAL_LIMIT,
+                           'reserve_bytes': RESERVE, 'tool_seconds': 120,
+                           'minimum_free_bytes': minimum_free},
+                'qualification': 'Synthetic stream-copy loop, not historical seed equivalence. '
+                                 'FFmpeg timeline/decoded-signal checks are not native playback '
+                                 'or proof of active thumbnail preparation.'}
+    (out / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
+    guard()
+    print(json.dumps(manifest['fixture']))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--ffmpeg', default='ffmpeg')
+    parser.add_argument('--ffprobe', default='ffprobe')
+    parser.add_argument('--output', type=Path, required=True)
+    modes = parser.add_mutually_exclusive_group()
+    modes.add_argument('--long-only', action='store_true',
+                        help='Generate only the optional five-minute source/remux, not the ordinary suite')
+    modes.add_argument('--playback-loop-source', type=Path,
+                       help='Stream-copy an explicit generated300s MP4 into an optional7200s playback fixture')
+    args = parser.parse_args()
+    if args.output.exists() or args.output.is_symlink():
+        parser.error('Refusing existing output directory; select a new --output')
+    out = args.output.resolve()
+    for key in ('ffmpeg', 'ffprobe'):
+        executable = shutil.which(getattr(args, key))
+        if executable is None:
+            parser.error('Executable not found: ' + key)
+        setattr(args, key, str(Path(executable).resolve()))
+    # Validate tools before allocating any output. No implicit binary sibling paths.
+    versions = {}
+    for tool, executable in [('ffmpeg', args.ffmpeg), ('ffprobe', args.ffprobe)]:
+        versions[tool] = subprocess.check_output(
+            [executable, '-version'], text=True, timeout=15)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    allowance = (PLAYBACK_TOTAL_LIMIT if args.playback_loop_source else
+                 LONG_TOTAL_LIMIT if args.long_only else LIMIT)
+    if shutil.disk_usage(out.parent).free < RESERVE + allowance:
+        parser.error('Need output allowance plus1GiB free reserve')
+    try:
+        out.mkdir(exist_ok=False)
+    except FileExistsError:
+        parser.error('Refusing existing output directory; select a new --output')
+    if args.long_only:
+        long_fixture(args, out, versions)
+        return
+    if args.playback_loop_source:
+        playback_fixture(args, out, versions)
+        return
+    commands = []
+
+    def check_space():
+        size = sum(path.stat().st_size for path in out.iterdir() if path.is_file())
+        if size > LIMIT or shutil.disk_usage(out).free < RESERVE + LIMIT:
+            raise RuntimeError('300 MiB output bound / 1 GiB reserve reached')
+        return size
+
