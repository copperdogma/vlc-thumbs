+    if not args.output.parent.is_dir():
+        parser.error('output parent must exist')
+    tools = {name: shutil.which(getattr(args, name)) for name in ('ffmpeg', 'ffprobe')}
+    if not all(tools.values()):
+        parser.error('FFmpeg with libx264/lavfi and ffprobe are required')
+    if shutil.disk_usage(args.output.parent).free < RESERVE + MAX_TOTAL:
+        parser.error('1 GiB free reserve plus 16 MiB fixture budget required')
