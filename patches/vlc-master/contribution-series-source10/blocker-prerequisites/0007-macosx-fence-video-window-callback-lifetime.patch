+++ b/modules/gui/macosx/windows/video/VLCVoutView.m
@@ -41,6 +41,95 @@
 #import "windows/video/VLCVideoWindowCommon.h"
 
 #import <vlc_actions.h>
+#include <stdatomic.h>
+
+@interface VLCVoutWindowLifetime ()
+{
+    vlc_window_t *_window;
+    vlc_mutex_t _resizeGate;
+    atomic_uint_fast64_t _generation;
+}
+@end
+
+@implementation VLCVoutWindowLifetime
+- (instancetype)initWithWindow:(vlc_window_t *)window
+{
+    self = [super init];
+    if (self) {
+        _window = window;
+        _windowKey = [NSValue valueWithPointer:window];
+        vlc_mutex_init(&_resizeGate);
+        atomic_init(&_generation, 0);
+    }
+    return self;
+}
+- (uint64_t)activeGeneration
+{
+    const uint64_t generation = atomic_load(&_generation);
+    return (generation & 1) ? generation : 0;
+}
+- (uint64_t)activate
+{
+    uint64_t generation = atomic_load(&_generation);
+    if (!(generation & 1)) {
+        assert(generation < UINT64_MAX - 1);
+        generation = atomic_fetch_add(&_generation, 1) + 1;
+    }
+    return generation;
+}
+- (void)revokeAndWait
+{
+    uint64_t generation = atomic_load(&_generation);
+    if (generation & 1)
+        atomic_fetch_add(&_generation, 1);
+    /* Disable follows display shutdown. Never use the view's mouse mutex here:
+     * its callbacks can enter fullscreen/window operations under window_lock. */
+    vlc_mutex_lock(&_resizeGate);
+    vlc_mutex_unlock(&_resizeGate);
+}
+- (void)invalidate
+{
+    [self revokeAndWait];
+    vlc_mutex_lock(&_resizeGate);
+    _window = NULL;
+    vlc_mutex_unlock(&_resizeGate);
+}
+- (void)reportSize:(NSSize)size generation:(uint64_t)generation
+{
+    vlc_mutex_lock(&_resizeGate);
+    if (_window != NULL && generation != 0 &&
+        generation == [self activeGeneration])
+        vlc_window_ReportSize(_window, size.width, size.height);
+    vlc_mutex_unlock(&_resizeGate);
+}
+@end
+
+int VLCVoutWindowOpen(vlc_window_t *window)
+{
+    VLCVoutWindowLifetime *lifetime = [[VLCVoutWindowLifetime alloc] initWithWindow:window];
+    if (lifetime == nil)
+        return VLC_ENOMEM;
+    window->sys = (void *)CFBridgingRetain(lifetime);
+    window->handle.nsobject = NULL;
+    return VLC_SUCCESS;
+}
+
+void VLCVoutWindowDestroy(vlc_window_t *window)
+{
+    VLCVoutWindowLifetime *lifetime = (__bridge_transfer VLCVoutWindowLifetime *)window->sys;
+    window->sys = NULL;
+    [lifetime invalidate];
+    /* Mouse target was detached before the view released its owned vout hold.
+     * Final vout_Release deletes this C window; never wait on a rebound view. */
+    void *retainedView = window->handle.nsobject;
+    window->handle.nsobject = NULL;
+    if (retainedView != NULL) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            id view = CFBridgingRelease(retainedView);
+            (void)view;
+        });
+    }
+}
 
