diff --git a/modules/gui/macosx/tests/VLCVoutLifetimeWiringTest.m b/modules/gui/macosx/tests/VLCVoutLifetimeWiringTest.m
new file mode 100644
index 0000000000000000000000000000000000000000..9c85613c7e34accc73063ffced0cb4446b973046 100644
--- /dev/null
+++ b/modules/gui/macosx/tests/VLCVoutLifetimeWiringTest.m
@@ -0,0 +1,216 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Actual provider/view TUs, actual registered operations. No GUI removal proof. */
+#include <vlc_common.h>
+#include <vlc_tick.h>
+#include <vlc_threads.h>
+#import "windows/video/VLCVoutView.h"
+#import "windows/video/VLCVideoOutputProvider.h"
+#import <objc/runtime.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <sched.h>
+
+extern int WindowOpen(vlc_window_t *);
+static VLCVideoOutputProvider *provider;
+static atomic_int failures;
+#define CHECK(x) do { if (!(x)) { fprintf(stderr,"FAIL %d: %s\n",__LINE__,#x); ++failures; } } while(0)
+static dispatch_semaphore_t entered, releaseCallback;
+static bool blockCallback;
+
+struct Owner {
+    atomic_uint calls;
+    atomic_bool retired;
+    unsigned width, height;
+};
+
+static void waitFor(dispatch_semaphore_t s)
+{
+    CHECK(dispatch_semaphore_wait(s, dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC)) == 0);
+}
+
+static void resized(vlc_window_t *w, unsigned width, unsigned height, vlc_window_ack_cb ack, void *opaque)
+{
+    struct Owner *o = w->owner.sys;
+    fprintf(stdout, "RESIZE width=%u height=%u\n", width, height);
+    CHECK(!atomic_load(&o->retired));
+    CHECK(width == o->width && height == o->height);
+    CHECK(!ack && !opaque);
+    atomic_fetch_add(&o->calls, 1);
+    if (blockCallback) {
+        dispatch_semaphore_signal(entered);
+        waitFor(releaseCallback);
+    }
+}
+
+static const struct vlc_window_callbacks callbacks = { .resized = resized };
+
+static dispatch_queue_t events(VLCVoutView *v)
+{
+    Ivar ivar = class_getInstanceVariable(VLCVoutView.class, "_eventQueue");
+    CHECK(ivar != NULL);
+    if (ivar == NULL)
+        abort();
+    return object_getIvar(v, ivar);
+}
+
+static void bindCurrent(VLCVoutView *v, vlc_window_t *w)
+{
+#ifdef VOUT_LIFETIME_BASELINE
+    v.voutWindow = w;
+#else
+    VLCVoutWindowLifetime *l = (__bridge VLCVoutWindowLifetime *)w->sys;
+    [v bindWindow:w lifetime:l generation:[l activate]];
+#endif
+}
+
+static void openBind(VLCVoutView *v, vlc_window_t *w, struct Owner *o)
+{
+    NSRect backing = [v convertRectToBacking:v.bounds];
+    CHECK(v.bounds.size.width == 320 && v.bounds.size.height == 180);
+    o->width = backing.size.width;
+    o->height = backing.size.height;
+    memset(w, 0, sizeof(*w));
+    w->owner.cbs = &callbacks;
+    w->owner.sys = o;
+    CHECK(WindowOpen(w) == VLC_SUCCESS);
+    CHECK(w->ops && w->ops->disable);
+    CHECK(w->ops->destroy != NULL);
+    bindCurrent(v, w);
+}
+
+static void destroy(vlc_window_t *w)
+{
+    if (w->ops->destroy)
+        w->ops->destroy(w);
+}
+
+static VLCVoutView *newView(void)
+{
+    VLCVoutView *v = [[VLCVoutView alloc] initWithFrame:NSMakeRect(0, 0, 320, 180)];
+    NSRect b = [v convertRectToBacking:v.bounds];
+    fprintf(stdout, "GEOMETRY bounds=%.0fx%.0f backing=%.0fx%.0f\n",
+            v.bounds.size.width, v.bounds.size.height, b.size.width, b.size.height);
+    return v;
+}
+
+static void queuedDestroy(void)
+{
+    int before = failures;
+    struct Owner o = {0};
+    vlc_window_t w;
+    VLCVoutView *v = newView();
+    openBind(v, &w, &o);
+    dispatch_semaphore_t blocked = dispatch_semaphore_create(0), resume = dispatch_semaphore_create(0);
+    dispatch_async(events(v), ^{
+        dispatch_semaphore_signal(blocked);
+        waitFor(resume);
+    });
+    waitFor(blocked);
+    [v layout];
+    destroy(&w);
+    atomic_store(&o.retired, true);
+    dispatch_semaphore_signal(resume);
+    dispatch_sync(events(v), ^{});
+    CHECK(atomic_load(&o.calls) == 0);
+    v.voutWindow = NULL;
+    fprintf(stdout, "CASE queued-destroy failures=%d\n", failures - before);
+}
+
+static void inFlight(bool close)
+{
+    int before = failures;
+    struct Owner o = {0};
+    vlc_window_t w;
+    VLCVoutView *v = newView();
+    openBind(v, &w, &o);
+    entered = dispatch_semaphore_create(0);
+    releaseCallback = dispatch_semaphore_create(0);
+    blockCallback = true;
+    [v layout];
+    waitFor(entered);
+    dispatch_semaphore_t done = dispatch_semaphore_create(0);
+    vlc_window_t *wp = &w;
+#ifndef VOUT_LIFETIME_BASELINE
+    VLCVoutWindowLifetime *life = (__bridge VLCVoutWindowLifetime *)w.sys;
+#endif
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0), ^{
+        if (close)
+            destroy(wp);
+        else
+            wp->ops->disable(wp);
+        dispatch_semaphore_signal(done);
+    });
+#ifndef VOUT_LIFETIME_BASELINE
+    /* Observe entry into actual revoke, not a signal before calling it. */
+    vlc_tick_t deadline = vlc_tick_now() + VLC_TICK_FROM_SEC(2);
+    while ([life activeGeneration] != 0 && vlc_tick_now() < deadline)
+        sched_yield();
+    CHECK([life activeGeneration] == 0);
+#endif
+    long early = dispatch_semaphore_wait(done, dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC));
+    CHECK(early != 0); /* Owner callback remains held; quiescence cannot complete. */
+    dispatch_semaphore_signal(releaseCallback);
+    if (early != 0)
+        waitFor(done);
+    dispatch_sync(events(v), ^{});
+    blockCallback = false;
+    if (!close)
+        destroy(&w);
+    atomic_store(&o.retired, true);
+    [v layout];
+    dispatch_sync(events(v), ^{});
+    CHECK(atomic_load(&o.calls) == 1);
+    v.voutWindow = NULL;
+    fprintf(stdout, "CASE inflight-%s failures=%d\n", close ? "destroy" : "disable", failures - before);
+}
+
+static void rebound(bool reuseAddress)
+{
+    int before = failures;
+    struct Owner first = {0}, second = {0};
+    vlc_window_t w;
+    VLCVoutView *v = newView();
+    openBind(v, &w, &first);
+    dispatch_semaphore_t blocked = dispatch_semaphore_create(0), resume = dispatch_semaphore_create(0);
+    dispatch_async(events(v), ^{
+        dispatch_semaphore_signal(blocked);
+        waitFor(resume);
+    });
+    waitFor(blocked);
+    [v layout];
+    if (reuseAddress) {
+        destroy(&w);
+        openBind(v, &w, &second);
+    } else {
+        w.ops->disable(&w);
+        second.width = first.width;
+        second.height = first.height;
+        w.owner.sys = &second;
+        bindCurrent(v, &w);
+    }
+    [v layout];
+    dispatch_semaphore_signal(resume);
+    dispatch_sync(events(v), ^{});
+    CHECK(atomic_load(&first.calls) == 0);
+    CHECK(atomic_load(&second.calls) == 1);
+    destroy(&w);
+    v.voutWindow = NULL;
+    fprintf(stdout, "CASE %s failures=%d\n", reuseAddress ? "address-reuse" : "disable-rebind", failures - before);
+}
+
+int main(void)
+{
+    @autoreleasepool {
+        CHECK(NSThread.isMainThread);
+        /* Process-lifetime provider; real init installs the normal ops admission.
+         * Nil GUI singleton prevents window creation/removal and media access. */
+        provider = [VLCVideoOutputProvider new];
+        queuedDestroy();
+        inFlight(false);
+        inFlight(true);
+        rebound(false);
+        rebound(true);
+    }
+    fprintf(stdout, "vout wiring total failures=%d\n", failures);
+    return failures ? 1 : 0;
+}
