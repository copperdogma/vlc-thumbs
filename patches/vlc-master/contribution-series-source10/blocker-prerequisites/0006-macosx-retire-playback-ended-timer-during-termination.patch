     BOOL _appleMusicPlaybackWasPaused;
     BOOL _spotifyPlaybackWasPaused;
 
+    BOOL _isTerminating; /* Main-thread terminal state; queued callbacks may outlive listeners. */
     NSTimer *_playbackHasTruelyEndedTimer;
     VLCInputItem *_currentMedia;
 
@@ -728,6 +729,10 @@ static int BossCallback(vlc_object_t *p_this,
 
 - (void)applicationWillTerminate:(NSNotification *)aNotification
 {
+    if (_isTerminating)
+        return;
+    _isTerminating = YES;
+
     libvlc_int_t *libvlc = vlc_object_instance(getIntf());
     var_DelCallback(libvlc, "intf-boss", BossCallback, (__bridge void *)self);
 
@@ -1010,6 +1015,9 @@ static int BossCallback(vlc_object_t *p_this,
 
