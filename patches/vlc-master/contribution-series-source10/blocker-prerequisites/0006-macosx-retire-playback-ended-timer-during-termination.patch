 - (void)onPlaybackHasTruelyEnded:(id)sender
 {
+    [_playbackHasTruelyEndedTimer invalidate];
+    _playbackHasTruelyEndedTimer = nil;
+
     msg_Dbg(getIntf(), "Playback has been ended");
 
     [self resumeOtherAudioPlaybackApps];
-    _playbackHasTruelyEndedTimer = nil;
