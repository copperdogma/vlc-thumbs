From c86a9695339b7835a97b7377aabb0a462e4dafef Mon Sep 17 00:00:00 2001
From: Cam Marsollier <cam.marsollier@gmail.com>
Date: Fri, 30 Oct 2026 10:55:33 -0600
Subject: [PATCH 01/16] macosx: hit-test autohide controls in local coordinates

Use the controller-owned bottom bar and convert the window pointer into each
control view's local bounds. This corrects missed-control hit testing caused by
the prior outlet and coordinate assumptions while retaining guard order and nil
behavior. Eleven source-extracted AppKit cases cover the change; returned-main
fade causality is not established. Apply before F0004's controller edits.
---
 .../windows/video/VLCMainVideoViewController.m     | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/modules/gui/macosx/windows/video/VLCMainVideoViewController.m b/modules/gui/macosx/windows/video/VLCMainVideoViewController.m
index 4c03ab46ab1f56fdf82cd0370acedcc76434fe6c..f31bd79ec97d32a5d3c456c81c138baf7208158d 100644
--- a/modules/gui/macosx/windows/video/VLCMainVideoViewController.m
+++ b/modules/gui/macosx/windows/video/VLCMainVideoViewController.m
@@ -410,10 +410,16 @@ NSString * const VLCUseClassicVideoPlayerLayoutKey = @"VLCUseClassicVideoPlayerL
 {
     NSPoint mousePos = [self.view.window mouseLocationOutsideOfEventStream];
 
-    return [_centralControlsStackView mouse:mousePos inRect:_centralControlsStackView.frame] ||
-        [_controlsBar.bottomBarView mouse:mousePos inRect: _controlsBar.bottomBarView.frame] ||
-        [_returnButton mouse:mousePos inRect: _returnButton.frame] ||
-        [_playQueueButton mouse:mousePos inRect: _playQueueButton.frame];
+    NSView *bottomBarView = self.bottomBarView;
+
+    return [_centralControlsStackView mouse:[_centralControlsStackView convertPoint:mousePos fromView:nil]
+                                    inRect:_centralControlsStackView.bounds] ||
+        [bottomBarView mouse:[bottomBarView convertPoint:mousePos fromView:nil]
+                      inRect:bottomBarView.bounds] ||
+        [_returnButton mouse:[_returnButton convertPoint:mousePos fromView:nil]
+                      inRect:_returnButton.bounds] ||
+        [_playQueueButton mouse:[_playQueueButton convertPoint:mousePos fromView:nil]
+                         inRect:_playQueueButton.bounds];
 }
 
 - (void)stopAutohideTimer
