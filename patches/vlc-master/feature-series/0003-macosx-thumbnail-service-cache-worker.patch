+              @"oldest alias evicted and recently used alias protected");
+        Check([aliases lookupTime:3000 maximumDistance:-1] != nil, @"overflow alias repeat reused");
+        Check([Cache(root, @"aliases-cap") lookupTime:3000 maximumDistance:-1] != nil,
