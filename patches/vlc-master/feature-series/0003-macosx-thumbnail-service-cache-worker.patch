+            videoInputID:(NSInteger)inputID
+              videoCount:(NSInteger)count
+                    time:(int64_t)time
+              completion:(VLCThumbnailCompletion)completion
+{
+    NSDictionary *context = @{
+        @"url" : url,
+        @"generation" : generation,
+        @"videoInputID" : @(inputID),
+        @"videoCount" : @(count),
+        @"videoStableID" : @"fixture-video-0",
+        @"duration" : @90000000,
+        @"sourceEpoch" : @1,
+        @"eligible" : @YES
+    };
+    NSDictionary *current = [self valueForKey:@"context"];
+    // Preserve intentionally prepared finite-coverage contexts in those tests.
+    if (![current[@"generation"] isEqual:generation])
+    {
+        [self prepareContext:context enabled:YES];
+        [self setValue:nil forKey:@"scheduler"];
+    }
+    else
+        context = current;
+    return [self requestForContext:context time:time completion:completion];
+}
+@end
