+        NSDictionary *retained = ManifestPath(root) ? Manifest(root) : nil;
+        NSString *file = retained[@"samples"][@"100"][@"file"];
+        NSString *payload =
+            file ? [root
+                       stringByAppendingPathComponent:[file stringByAppendingPathExtension:@"rgba"]]
+                 : nil;
+        fd = payload ? open(payload.fileSystemRepresentation, O_WRONLY | O_NOFOLLOW) : -1;
+        Check(fd >= 0 && ftruncate(fd, 300 * 1024 * 1024) == 0,
+              @"replace protected disk size with oversized sparse fault");
+        if (fd >= 0)
+            close(fd);
+        [cache storeRaw:Raw(200, NO) requestedTime:201 actualTime:200 allowEviction:NO];
+        uint64_t total = 0;
+        for (NSString *name in [fm contentsOfDirectoryAtPath:root error:NULL])
+        {
+            struct stat state;
+            NSString *path = [root stringByAppendingPathComponent:name];
