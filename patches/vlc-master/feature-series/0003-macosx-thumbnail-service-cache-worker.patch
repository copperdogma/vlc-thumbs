+    });
+    for (NSNumber *newer in @[ @NO, @YES ])
+        Scenario(@"hot RAM retention under older and newer background quota pressure", ^{
+            NSString *root = NewRoot(parent, [NSString stringWithFormat:@"hot-quota-%@", newer]);
