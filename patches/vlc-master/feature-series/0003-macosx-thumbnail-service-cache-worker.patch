+- (void)testQueuedValidationDoesNotExtendProvisionalDeadline
+{
+    root = [TestTemporaryDirectory() stringByAppendingPathComponent:NSUUID.UUID.UUIDString];
+    [NSFileManager.defaultManager createDirectoryAtPath:root
+                            withIntermediateDirectories:YES
+                                             attributes:nil
+                                                  error:nil];
+    NSURL *input = Input(@"queued-deadline", @"metadata-slow");
+    VLCThumbnailService *service = Service(@"cache");
+    XCTAssertTrue([Request(service, input, @"queued-deadline", 2000000)[@"has_image"] boolValue]);
+    NSString *startsPath = [input.path stringByAppendingString:@".statcalls"];
+    NSString *endsPath = [input.path stringByAppendingString:@".statends"];
+    NSUInteger (^lines)(NSString *) = ^NSUInteger(NSString *path) {
+        NSString *text = [NSString stringWithContentsOfFile:path
+                                                   encoding:NSUTF8StringEncoding
+                                                      error:nil];
+        return text.length ? [text componentsSeparatedByString:@"\n"].count - 1 : 0;
+    };
+    NSUInteger initialStarts = lines(startsPath), initialEnds = lines(endsPath);
+    [@"10" writeToFile:[input.path stringByAppendingString:@".metadata-delay"]
+            atomically:YES
+              encoding:NSUTF8StringEncoding
+                 error:nil];
+    [service requestURL:input
+             generation:@"queued-deadline"
+           videoInputID:0
+             videoCount:1
+                   time:8000000
+             completion:^(NSImage *image, NSDictionary *reply) {
+                 (void)image;
+                 (void)reply;
+             }];
+    double startDeadline = Now() + 2;
+    while (lines(startsPath) == initialStarts && Now() < startDeadline)
+        Spin(.01);
+    XCTAssertEqual(lines(startsPath), initialStarts + 1);
+    __block BOOL provisional = NO, cleared = NO;
+    __block double shownAt = 0, clearedAt = 0;
+    __block NSUInteger startsAtClear = 0, endsAtClear = 0;
+    double requestedAt = Now();
+    [service requestURL:input
+             generation:@"queued-deadline"
+           videoInputID:0
+             videoCount:1
+                   time:2000000
+             completion:^(NSImage *image, NSDictionary *reply) {
+                 if (image && [reply[@"verification_pending"] boolValue] && !provisional)
+                 {
+                     provisional = YES;
+                     shownAt = Now();
+                 }
+                 if (!image && reply[@"error"] && !cleared)
+                 {
+                     cleared = YES;
+                     clearedAt = Now();
+                     startsAtClear = lines(startsPath);
+                     endsAtClear = lines(endsPath);
+                     XCTAssertEqualObjects(reply[@"error"], @"timeout");
+                 }
+             }];
+    double expiryDeadline = requestedAt + 17;
+    while (!cleared && Now() < expiryDeadline)
+        Spin(.01);
+    XCTAssertTrue(provisional);
+    XCTAssertTrue(cleared);
+    XCTAssertLessThan(shownAt - requestedAt, .5);
+    XCTAssertGreaterThanOrEqual(clearedAt - shownAt, 14.8);
+    XCTAssertLessThan(clearedAt - shownAt, 16.2);
+    // A completed below its 15 s worker deadline; B is still pending after its queue wait.
+    XCTAssertEqual(startsAtClear, initialStarts + 2);
+    XCTAssertEqual(endsAtClear, initialEnds + 1);
+    [service shutdown];
+    Spin(.3);
+    [NSFileManager.defaultManager removeItemAtPath:root error:nil];
+}
