+- (void)testWorkerCommandDeadlineAndPartialWrites
+{
+    // Published Darwin XNU limits buffered pipes to PIPE_SIZE * 4 (64 KiB).
+    // A 256 KiB no-reader write exceeds that cap even if a full pipe grows.
+    // This is a Darwin fault fixture, not a universal POSIX pipe-capacity claim.
+    // https://github.com/apple-oss-distributions/xnu/blob/main/bsd/kern/sys_pipe.c
+    NSData *blocked = [NSMutableData dataWithLength:256 * 1024];
+    int descriptors[2];
+    XCTAssertEqual(pipe(descriptors), 0);
+    VLCThumbnailWorker *timeoutWorker = [[VLCThumbnailWorker alloc] initWithHelperPath:@"/unused"];
+    double started = Now();
+    XCTAssertFalse([timeoutWorker writeCommand:blocked
+                                    descriptor:descriptors[1]
+                                      deadline:started + .15
+                                         epoch:0]);
+    XCTAssertGreaterThanOrEqual(Now() - started, .10);
+    XCTAssertLessThan(Now() - started, .75);
+    close(descriptors[0]);
+    close(descriptors[1]);
+
+    XCTAssertEqual(pipe(descriptors), 0);
+    VLCThumbnailWorker *cancelWorker = [[VLCThumbnailWorker alloc] initWithHelperPath:@"/unused"];
+    dispatch_semaphore_t invalidated = dispatch_semaphore_create(0);
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 50 * NSEC_PER_MSEC),
+                   dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0), ^{
+                       [cancelWorker invalidate];
+                       dispatch_semaphore_signal(invalidated);
+                   });
+    started = Now();
+    XCTAssertFalse([cancelWorker writeCommand:blocked
+                                   descriptor:descriptors[1]
+                                     deadline:started + 2
+                                        epoch:0]);
+    XCTAssertLessThan(Now() - started, .75);
+    // Join on every outcome before cleanup; later cases use independent epochs.
+    XCTAssertEqual(
+        dispatch_semaphore_wait(invalidated, dispatch_time(DISPATCH_TIME_NOW, 750 * NSEC_PER_MSEC)),
+        0L);
+    close(descriptors[0]);
+    close(descriptors[1]);
+
+    XCTAssertEqual(pipe(descriptors), 0);
+    VLCThumbnailWorker *disconnectedWorker =
+        [[VLCThumbnailWorker alloc] initWithHelperPath:@"/unused"];
+    NSData *command = [@"1 1000\n" dataUsingEncoding:NSASCIIStringEncoding];
+    close(descriptors[0]);
+    // A disconnected reader must fail without global SIGPIPE changes.
+    XCTAssertFalse([disconnectedWorker writeCommand:command
+                                         descriptor:descriptors[1]
+                                           deadline:Now() + 1
+                                              epoch:0]);
+    close(descriptors[1]);
+
+    XCTAssertEqual(pipe(descriptors), 0);
+    VLCThumbnailWorker *drainWorker = [[VLCThumbnailWorker alloc] initWithHelperPath:@"/unused"];
+    int reader = descriptors[0], writer = descriptors[1];
+    XCTAssertEqual(fcntl(reader, F_SETFL, O_NONBLOCK), 0);
+    NSMutableData *large = [NSMutableData dataWithLength:256 * 1024];
+    for (NSUInteger i = 0; i < large.length; i++)
+        ((uint8_t *)large.mutableBytes)[i] = (uint8_t)i;
+    __block NSMutableData *received = NSMutableData.data;
+    XCTestExpectation *drained = [self expectationWithDescription:@"bounded partial-write drain"];
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0), ^{
+        double deadline = Now() + 2;
+        uint8_t bytes[1024];
+        while (received.length < large.length && Now() < deadline)
+        {
+            ssize_t count = read(reader, bytes, sizeof bytes);
+            if (count > 0)
+                [received appendBytes:bytes length:(NSUInteger)count];
+            else if (count == 0 || (errno != EAGAIN && errno != EINTR))
+                break;
+            usleep(1000);
+        }
+        [drained fulfill];
+    });
+    XCTAssertTrue([drainWorker writeCommand:large descriptor:writer deadline:Now() + 2 epoch:0]);
+    [self waitForExpectationsWithTimeout:3 handler:nil];
+    XCTAssertEqualObjects(received, large);
+    close(reader);
+    close(writer);
+}
