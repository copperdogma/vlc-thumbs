+        [fm removeItemAtPath:payload error:NULL];
+        Check(link(owner.fileSystemRepresentation, payload.fileSystemRepresentation) == 0,
+              @"swap payload for owner hard link");
+        Check([[cache residentLookupTime:101 maximumDistance:-1][@"cache"] isEqual:@"memory"],
+              @"hard-linked payload retains safe RAM fallback");
+        lstat(owner.fileSystemRepresentation, &state);
