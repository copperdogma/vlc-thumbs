+static void Spin(double s)
+{
+    double end = Now() + s;
+    do
+    {
+        [NSRunLoop.mainRunLoop runUntilDate:[NSDate dateWithTimeIntervalSinceNow:.001]];
+    } while (Now() < end);
+}
+static void Check(NSString *name, BOOL passed, NSDictionary *detail)
+{
+    [checks addObject:@{@"name" : name, @"passed" : @(passed), @"detail" : detail ?: @{}}];
+    if (!passed)
+    {
+        failed++;
+        fprintf(stderr, "FAIL %s\n", name.UTF8String);
