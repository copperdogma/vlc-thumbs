+        NSString *moved = [root stringByAppendingString:@"-moved"];
+        [fm moveItemAtPath:root toPath:moved error:NULL];
+        NSString *outside = NewRoot(parent, @"touch-outside");
+        Check(symlink(outside.fileSystemRepresentation, root.fileSystemRepresentation) == 0,
