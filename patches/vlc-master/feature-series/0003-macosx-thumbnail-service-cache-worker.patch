+                if (!lstat(path.fileSystemRepresentation, &state))
+                    initial += state.st_size;
+            }
+            NSString *filler =
+                [root stringByAppendingPathComponent:[Digest([@"hot-quota-filler"
+                                                         dataUsingEncoding:NSUTF8StringEncoding])
+                                                         stringByAppendingPathExtension:@"rgba"]];
+            int fd = open(filler.fileSystemRepresentation, O_WRONLY | O_CREAT | O_EXCL, 0600);
+            Check(fd >= 0 && ftruncate(fd, 256 * 1024 * 1024 - initial) == 0,
