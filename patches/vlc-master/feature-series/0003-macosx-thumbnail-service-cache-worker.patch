+- (void)testTerminalCompletionCanRequestAnotherHover
+{
+    NSString *temporary =
+        [TestTemporaryDirectory() stringByAppendingPathComponent:NSUUID.UUID.UUIDString];
+    [NSFileManager.defaultManager createDirectoryAtPath:temporary
+                            withIntermediateDirectories:YES
+                                             attributes:nil
+                                                  error:nil];
+    NSURL *input = [NSURL fileURLWithPath:[temporary stringByAppendingPathComponent:@"input"]];
+    [@"valid" writeToURL:input atomically:YES encoding:NSUTF8StringEncoding error:nil];
+    VLCThumbnailService *service = [[VLCThumbnailService alloc]
+        initWithHelperPath:@VLC_MACOSX_TEST_HELPER_PATH
+                 cacheRoot:[temporary stringByAppendingPathComponent:@"cache"]];
+    [service prepareContext:@{
+        @"generation" : @"terminal-reentrant",
+        @"sourceEpoch" : @1,
+        @"url" : input,
+        @"duration" : @90000000,
+        @"eligible" : @YES,
+        @"videoStableID" : @"fixture-video-0",
+        @"videoInputID" : @0,
+        @"videoCount" : @1
+    } enabled:YES];
+    [service setValue:nil forKey:@"scheduler"];
+    // Seed only A's terminal history; B must take the ordinary cache/decode path.
+    NSMutableDictionary *failures = [service valueForKey:@"failures"];
+    failures[@1000000] =
+        @{@"terminal" : @YES, @"last" : @(Now()), @"error" : @"decode-unavailable"};
+    XCTestExpectation *finished = [self expectationWithDescription:@"reentrant hover image"];
+    __block NSUInteger terminalCallbacks = 0;
+    [service requestURL:input
+             generation:@"terminal-reentrant"
+           videoInputID:0
+             videoCount:1
+                   time:1000000
+             completion:^(NSImage *image, NSDictionary *reply) {
+                 terminalCallbacks++;
+                 XCTAssertNil(image);
+                 XCTAssertEqualObjects(reply[@"error"], @"decode-unavailable");
+                 [service requestURL:input
+                          generation:@"terminal-reentrant"
+                        videoInputID:0
+                          videoCount:1
+                                time:2000000
+                          completion:^(NSImage *nextImage, NSDictionary *nextReply) {
+                              if ([nextReply[@"preparing"] boolValue] ||
+                                  [nextReply[@"verification_pending"] boolValue])
+                                  return;
+                              XCTAssertNotNil(nextImage);
+                              XCTAssertTrue([nextReply[@"ok"] boolValue]);
+                              XCTAssertEqualObjects(nextReply[@"requested_us"], @2000000);
+                              [finished fulfill];
+                          }];
+             }];
+    [self waitForExpectationsWithTimeout:5 handler:nil];
+    XCTAssertEqual(terminalCallbacks, 1U);
+    [service shutdown];
+    Spin(.1);
+    [NSFileManager.defaultManager removeItemAtPath:temporary error:nil];
+}
+
+- (void)testFinitePreparationBecomesQuiescent
+{
+    NSString *temporary =
+        [TestTemporaryDirectory() stringByAppendingPathComponent:NSUUID.UUID.UUIDString];
+    [NSFileManager.defaultManager createDirectoryAtPath:temporary
+                            withIntermediateDirectories:YES
+                                             attributes:nil
+                                                  error:nil];
+    NSURL *input = [NSURL fileURLWithPath:[temporary stringByAppendingPathComponent:@"input"]];
+    [@"valid" writeToURL:input atomically:YES encoding:NSUTF8StringEncoding error:nil];
+    VLCThumbnailService *service = [[VLCThumbnailService alloc]
+        initWithHelperPath:@VLC_MACOSX_TEST_HELPER_PATH
+                 cacheRoot:[temporary stringByAppendingPathComponent:@"cache"]];
+    [service prepareContext:@{
+        @"generation" : @"finite",
+        @"sourceEpoch" : @1,
+        @"url" : input,
+        @"duration" : @8000000,
+        @"eligible" : @YES,
+        @"videoStableID" : @"fixture",
+        @"videoInputID" : @0,
+        @"videoCount" : @1
+    }
+                    enabled:YES];
+    VLCThumbnailScheduler *scheduler = [service valueForKey:@"scheduler"];
+    double finishDeadline = Now() + 5;
+    while ((scheduler.completedCount != scheduler.targets.count ||
+            [service.metrics[@"active"] boolValue]) &&
+           Now() < finishDeadline)
+        Spin(.01);
+    XCTAssertEqual(scheduler.completedCount, scheduler.targets.count);
+    XCTAssertGreaterThan(scheduler.completedCount, 0U);
+    NSDictionary *before = service.metrics;
+    NSDictionary *scheduleBefore = scheduler.diagnostics;
+    XCTAssertFalse([before[@"active"] boolValue]);
+    Spin(1.2);
+    XCTAssertEqualObjects(service.metrics[@"worker_requests"], before[@"worker_requests"]);
+    XCTAssertEqualObjects(service.metrics[@"completed"], before[@"completed"]);
+    XCTAssertEqualObjects(service.metrics[@"launched"], before[@"launched"]);
+    XCTAssertEqualObjects(scheduler.diagnostics, scheduleBefore);
+    XCTAssertFalse([service.metrics[@"active"] boolValue]);
+    XCTAssertNil([service valueForKey:@"wake"]);
+    [service shutdown];
+    Spin(.1);
+    [NSFileManager.defaultManager removeItemAtPath:temporary error:nil];
+}
+
+- (void)testHungWorkerPIDDisappearsBeforeRecovery
+{
+    NSString *temporary =
+        [TestTemporaryDirectory() stringByAppendingPathComponent:NSUUID.UUID.UUIDString];
+    [NSFileManager.defaultManager createDirectoryAtPath:temporary
+                            withIntermediateDirectories:YES
+                                             attributes:nil
+                                                  error:nil];
+    NSURL *input = [NSURL fileURLWithPath:[temporary stringByAppendingPathComponent:@"input"]];
+    [@"hang" writeToURL:input atomically:YES encoding:NSUTF8StringEncoding error:nil];
+    VLCThumbnailWorker *worker =
+        [[VLCThumbnailWorker alloc] initWithHelperPath:@VLC_MACOSX_TEST_HELPER_PATH];
+    XCTestExpectation *timedOut = [self expectationWithDescription:@"hung helper bounded timeout"];
+    __block NSDictionary *reply;
+    dispatch_queue_t queue =
+        dispatch_queue_create("org.videolan.vlc.thumbnail-test", DISPATCH_QUEUE_SERIAL);
+    dispatch_async(queue, ^{
+        reply = [worker requestURL:input videoInputID:0 videoCount:1 time:0];
+        [timedOut fulfill];
+    });
+    NSString *pidPath = [input.path stringByAppendingString:@".worker-pid"];
+    pid_t pid = 0;
+    double pidDeadline = Now() + 2;
+    while (pid <= 0 && Now() < pidDeadline)
+    {
+        pid = (pid_t)[[NSString stringWithContentsOfFile:pidPath
+                                                encoding:NSUTF8StringEncoding
+                                                   error:nil] intValue];
+        Spin(.01);
+    }
+    XCTAssertGreaterThan(pid, 0);
+    XCTAssertEqual(kill(pid, 0), 0);
+    [self waitForExpectationsWithTimeout:18 handler:nil];
+    XCTAssertEqualObjects(reply[@"error"], @"timeout");
+    double reapedDeadline = Now() + 2;
+    while (pid > 0 && kill(pid, 0) == 0 && Now() < reapedDeadline)
+        Spin(.01);
+    int status = kill(pid, 0), disappearanceError = errno;
+    XCTAssertEqual(status, -1);
+    XCTAssertEqual(disappearanceError, ESRCH);
+    // Do not call waitpid: NSTask owns reaping. ESRCH proves the captured process is absent.
+    [@"valid" writeToURL:input atomically:YES encoding:NSUTF8StringEncoding error:nil];
+    XCTestExpectation *recovered =
+        [self expectationWithDescription:@"worker recovers after retired PID"];
+    dispatch_async(queue, ^{
+        reply = [worker requestURL:input videoInputID:0 videoCount:1 time:0];
+        [worker invalidate];
+        [worker fingerprintURL:input policy:@"stat"];
+        [recovered fulfill];
+    });
+    [self waitForExpectationsWithTimeout:3 handler:nil];
+    XCTAssertNotNil(reply[@"raw"]);
+    XCTAssertEqual([worker.metrics[@"launched"] unsignedIntegerValue], 2U);
+    status = kill(pid, 0);
+    disappearanceError = errno;
+    XCTAssertEqual(status, -1);
+    XCTAssertEqual(disappearanceError, ESRCH);
+    [NSFileManager.defaultManager removeItemAtPath:temporary error:nil];
+}
+
+@end
diff --git a/modules/gui/macosx/tests/VLCThumbnailTestHelper.c b/modules/gui/macosx/tests/VLCThumbnailTestHelper.c
new file mode 100644
index 0000000000000000000000000000000000000000..d60b683f04658ea9eca361567c470ebca4d82ad1
--- /dev/null
+++ b/modules/gui/macosx/tests/VLCThumbnailTestHelper.c
@@ -0,0 +1,207 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Test-owned protocol and lifecycle faults. Never used for media decoding.
+ */
+#include <CommonCrypto/CommonDigest.h>
+#include <errno.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static char mode[64];
+static int input_id, video_count;
+
+static int load_mode(const char *path)
+{
+    FILE *file = fopen(path, "rb");
+    if (file == NULL)
+        return -1;
+    size_t length = fread(mode, 1, sizeof(mode) - 1, file);
+    mode[length] = '\0';
+    fclose(file);
+    while (length && (mode[length - 1] == '\n' || mode[length - 1] == ' '))
+        mode[--length] = '\0';
+    return 0;
+}
+
+static void selection(void)
+{
+    printf(
+        "\"video_input_id\":%d,\"video_count\":%d,\"mapping\":\"single\",\"video_track_number\":-1",
+        input_id, video_count);
+}
+
+static int fingerprint(const char *path, const char *policy)
+{
+    if (!strcmp(policy, "stat") && !strcmp(mode, "metadata-slow"))
+    {
+        char *log_path = NULL, *delay_path = NULL;
+        if (asprintf(&log_path, "%s.statcalls", path) < 0 ||
+            asprintf(&delay_path, "%s.metadata-delay", path) < 0)
+            return 2;
+        FILE *file = fopen(log_path, "ab");
+        if (file != NULL)
+        {
+            fputs("stat\n", file);
+            fclose(file);
+        }
+        file = fopen(delay_path, "rb");
+        double delay = .25;
+        if (file != NULL)
+        {
+            if (fscanf(file, "%lf", &delay) != 1)
+                delay = .25;
+            fclose(file);
+        }
+        free(log_path);
+        free(delay_path);
+        if (delay > 0 && delay < 60)
+            usleep((useconds_t)(delay * 1000000));
+    }
+    if (!strcmp(policy, "stat") && !strcmp(mode, "metadata-slow"))
+    {
+        char *end_path = NULL;
+        if (asprintf(&end_path, "%s.statends", path) < 0)
+            return 2;
+        FILE *file = fopen(end_path, "ab");
+        if (file != NULL)
+        {
+            fputs("stat\n", file);
+            fclose(file);
+        }
+        free(end_path);
+    }
+    struct stat state;
+    if (stat(path, &state))
+        return 2;
+    char identity[256];
+    snprintf(identity, sizeof(identity), "%ju:%ju:%jd:%jd:%ld:%jd:%ld", (uintmax_t)state.st_dev,
+             (uintmax_t)state.st_ino, (intmax_t)state.st_size, (intmax_t)state.st_mtimespec.tv_sec,
+             state.st_mtimespec.tv_nsec, (intmax_t)state.st_ctimespec.tv_sec,
+             state.st_ctimespec.tv_nsec);
+    unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+    size_t bytes = 0;
+    if (!strcmp(policy, "stat"))
+        CC_SHA256(identity, (CC_LONG)strlen(identity), digest);
+    else
+    {
+        /* All test input files are bounded textual modes. */
+        FILE *file = fopen(path, "rb");
+        if (file == NULL)
+            return 2;
+        unsigned char content[64];
+        bytes = fread(content, 1, sizeof(content), file);
+        fclose(file);
+        CC_SHA256(content, (CC_LONG)bytes, digest);
+    }
+    char hex[CC_SHA256_DIGEST_LENGTH * 2 + 1];
+    for (size_t i = 0; i < sizeof(digest); ++i)
+        snprintf(hex + 2 * i, 3, "%02x", digest[i]);
+    printf(
+        "{\"version\":4,\"type\":\"identity\",\"ok\":true,\"fingerprint\":\"%s\",\"policy\":\"%s\","
+        "\"stat_identity\":\"%s\",\"bytes_read\":%zu,\"read_calls\":%d,\"payload_bytes\":0}\n",
+        hex, policy, identity, bytes, strcmp(policy, "stat") != 0);
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    const char *path = NULL, *policy = NULL;
+    input_id = 0;
+    video_count = 1;
+    for (int i = 1; i < argc; ++i)
+    {
+        if (!strcmp(argv[i], "--fingerprint") && i + 1 < argc)
+            policy = argv[++i];
+        else if (!strcmp(argv[i], "--input") && i + 1 < argc)
+            path = argv[++i];
+        else if (!strcmp(argv[i], "--video-input-id") && i + 1 < argc)
+            input_id = atoi(argv[++i]);
+        else if (!strcmp(argv[i], "--video-count") && i + 1 < argc)
+            video_count = atoi(argv[++i]);
+        else if ((!strcmp(argv[i], "--max-width") || !strcmp(argv[i], "--max-height")) &&
+                 i + 1 < argc)
+            ++i;
+        else if (strcmp(argv[i], "--worker"))
+            return 2;
+    }
+    if (path == NULL || load_mode(path))
+        return 2;
+    setvbuf(stdout, NULL, _IONBF, 0);
+    if (policy != NULL)
+        return fingerprint(path, policy);
+    char *pid_path = NULL;
+    if (asprintf(&pid_path, "%s.worker-pid", path) < 0)
+        return 2;
+    FILE *pid_file = fopen(pid_path, "wb");
+    if (pid_file != NULL)
+    {
+        fprintf(pid_file, "%d\n", getpid());
+        fclose(pid_file);
+    }
+    free(pid_path);
+    if (!strcmp(mode, "startup-hang"))
+        sleep(40);
+    if (!strcmp(mode, "startup-malformed"))
+    {
+        puts("garbage");
+        return 0;
+    }
+    printf("{\"version\":4,\"type\":\"ready\",\"ok\":true,\"duration_us\":90000000,");
+    selection();
+    puts("}");
+    char line[128];
+    while (fgets(line, sizeof(line), stdin))
+    {
+        unsigned long ident;
+        int64_t target;
+        if (sscanf(line, "%lu %" SCNd64, &ident, &target) != 2)
+            return 2;
+        if (!strcmp(mode, "slow") || !strcmp(mode, "mutating"))
+            usleep(250000);
+        if (!strcmp(mode, "cache-slow"))
+            sleep(1);
+        if (!strcmp(mode, "hang"))
+            sleep(40);
+        if (!strcmp(mode, "crash"))
+            return 1;
+        if (!strcmp(mode, "malformed"))
+        {
+            printf("{\"version\":4,\"id\":%lu,\"requested_us\":%" PRId64
+                   ",\"ok\":true,\"payload_bytes\":999999999}\n",
+                   ident, target);
+            continue;
+        }
+        if (!strcmp(mode, "fractional"))
+        {
+            printf("{\"version\":4.5,\"id\":%lu,\"requested_us\":%" PRId64
+                   ",\"ok\":true,\"payload_bytes\":0}\n",
+                   ident, target);
+            continue;
+        }
+        if (!strcmp(mode, "unsupported") || (!strcmp(mode, "fail-once") && ident == 1))
+        {
+            printf("{\"version\":4,\"id\":%lu,\"requested_us\":%" PRId64
+                   ",\"ok\":false,\"payload_bytes\":0,\"error\":\"%s\"}\n",
+                   ident, target,
+                   !strcmp(mode, "unsupported") ? "unsupported_codec" : "read_failed");
+            continue;
+        }
+        int64_t actual = target / 2000000 * 2000000;
+        printf("{\"version\":4,\"id\":%lu,\"ok\":true,\"sampling\":\"keyframe\",\"requested_us\":"
+               "%" PRId64 ",\"actual_us\":%" PRId64
+               ",\"width\":64,\"height\":36,\"channels\":%" PRIu64
+               ",\"payload_bytes\":9216,\"open_count\":1,",
+               ident, target, actual,
+               !strcmp(mode, "channel-overflow") ? UINT64_C(4294967300) : UINT64_C(4));
+        selection();
+        puts("}");
+        const unsigned char pixel[] = {30, 90, 160, 255};
+        for (size_t p = 0; p < 64 * 36; ++p)
+            if (fwrite(pixel, sizeof(pixel), 1, stdout) != 1)
+                return 2;
+    }
+    return ferror(stdin) ? 2 : 0;
+}
diff --git a/modules/gui/macosx/timeline/VLCThumbnailCache.h b/modules/gui/macosx/timeline/VLCThumbnailCache.h
new file mode 100644
