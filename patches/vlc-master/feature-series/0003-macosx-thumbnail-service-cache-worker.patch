+        Check(!samples.hasCapacity, @"512 samples stop background capacity");
+        Check(![samples storeRaw:Raw(512, NO) requestedTime:512 actualTime:512],
+              @"513th distinct sample rejected");
+        for (int64_t i = 0; i < 512; i++)
