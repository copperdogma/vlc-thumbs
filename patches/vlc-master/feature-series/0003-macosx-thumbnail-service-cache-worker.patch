+int64_t VLCThumbnailBridgeDistance(int64_t duration);
diff --git a/modules/gui/macosx/timeline/VLCThumbnailService.m b/modules/gui/macosx/timeline/VLCThumbnailService.m
new file mode 100644
index 0000000000000000000000000000000000000000..d5e408faedb9d65ba6aa50d44665861dbdb21297
--- /dev/null
+++ b/modules/gui/macosx/timeline/VLCThumbnailService.m
@@ -0,0 +1,984 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#import "VLCThumbnailService.h"
+#import "VLCThumbnailCache.h"
