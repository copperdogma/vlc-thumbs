+    [fm removeItemAtPath:parent error:NULL];
+    XCTAssertGreaterThanOrEqual(checks, 3410U);
+    for (NSString *failure in failures)
+        XCTAssertTrue(NO, @"%@", failure);
+}
+// Optional physical fault test; the controller must supply a verified owned mount.
+- (void)testOwnedVolumeENOSPCRAMAndRecovery
+{
+    NSDictionary *environment = NSProcessInfo.processInfo.environment;
+    NSString *mount = environment[@"VLC_THUMBNAIL_ENOSPC_ROOT"];
+    XCTSkipIf(mount.length == 0, @"Requires an explicitly owned constrained test volume");
+    NSString *device = environment[@"VLC_THUMBNAIL_ENOSPC_DEVICE"];
+    NSString *nonce = environment[@"VLC_THUMBNAIL_ENOSPC_NONCE"];
+    NSString *workspace = environment[@"VLC_THUMBNAIL_ENOSPC_WORKSPACE"];
+    char *canonical = realpath(mount.fileSystemRepresentation, NULL);
+    BOOL canonicalMount =
+        canonical && [mount isEqualToString:[NSString stringWithUTF8String:canonical]];
+    free(canonical);
+    struct statfs volume, workspaceState;
+    struct stat mountState, workspaceIdentity;
+    BOOL safe = canonicalMount && device.length && nonce.length >= 32 && workspace.length &&
+                [mount hasPrefix:[[workspace stringByAppendingPathComponent:@"work"]
+                                     stringByAppendingString:@"/"]] &&
+                statfs(mount.fileSystemRepresentation, &volume) == 0 &&
+                statfs(workspace.fileSystemRepresentation, &workspaceState) == 0 &&
+                stat(mount.fileSystemRepresentation, &mountState) == 0 &&
+                stat(workspace.fileSystemRepresentation, &workspaceIdentity) == 0 &&
+                mountState.st_dev != workspaceIdentity.st_dev &&
+                !strcmp(volume.f_fstypename, "hfs") &&
+                !strcmp(volume.f_mntonname, mount.fileSystemRepresentation) &&
+                !strcmp(volume.f_mntfromname, device.fileSystemRepresentation) &&
+                (uint64_t)volume.f_blocks * volume.f_bsize <= 32ULL * 1024 * 1024 &&
+                (uint64_t)workspaceState.f_bavail * workspaceState.f_bsize >= 1024ULL * 1024 * 1024;
+    NSString *ownership = [mount stringByAppendingPathComponent:@".vlc-thumbnail-owned-volume"];
+    struct stat marker;
+    safe = safe && lstat(ownership.fileSystemRepresentation, &marker) == 0 &&
+           S_ISREG(marker.st_mode) &&
+           [[NSString stringWithContentsOfFile:ownership encoding:NSUTF8StringEncoding
+                                         error:nil] isEqualToString:nonce];
+    XCTAssertTrue(safe, @"Refusing unverified, unowned or oversized mount");
+    if (!safe)
+        return;
+    fm = NSFileManager.defaultManager;
+    NSString *cacheRoot = [mount stringByAppendingPathComponent:NSUUID.UUID.UUIDString];
+    NSString *filler = [mount stringByAppendingPathComponent:NSUUID.UUID.UUIDString];
+    NSString *identity = @"native-enospc-protocol4-cache5";
+    int descriptor = -1;
+    @try
+    {
+        VLCThumbnailCache *cache = Cache(cacheRoot, identity);
+        XCTAssertTrue([cache storeRaw:Raw(100, YES) requestedTime:100 actualTime:100]);
+        VLCThumbnailCache *seedReopen = Cache(cacheRoot, identity);
+        XCTAssertEqualObjects([seedReopen lookupTime:100 maximumDistance:-1][@"cache"], @"disk");
+        descriptor =
+            open(filler.fileSystemRepresentation, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600);
+        XCTAssertGreaterThanOrEqual(descriptor, 0);
+        if (descriptor < 0)
+            return;
+        uint8_t bytes[65536] = {0};
+        NSUInteger filled = 0;
+        int fillError = 0;
+        while (filled < 32U * 1024 * 1024)
+        {
+            if (statfs(workspace.fileSystemRepresentation, &workspaceState) ||
+                (uint64_t)workspaceState.f_bavail * workspaceState.f_bsize < 1024ULL * 1024 * 1024)
+            {
+                fillError = ECANCELED;
+                break;
+            }
+            ssize_t count = write(descriptor, bytes, sizeof bytes);
+            if (count > 0)
+                filled += (NSUInteger)count;
+            else if (count < 0 && errno == EINTR)
+                continue;
+            else
+            {
+                fillError = count < 0 ? errno : EIO;
+                break;
+            }
+        }
+        close(descriptor);
+        descriptor = -1;
+        XCTAssertEqual(fillError, ENOSPC);
+        if (fillError != ENOSPC)
+            return;
+        XCTAssertTrue([cache storeRaw:Raw(200, YES) requestedTime:200 actualTime:200]);
+        XCTAssertEqualObjects([cache lookupTime:200 maximumDistance:-1][@"cache"], @"memory");
+        VLCThumbnailCache *fullReopen = Cache(cacheRoot, identity);
+        XCTAssertEqualObjects([fullReopen lookupTime:100 maximumDistance:-1][@"cache"], @"disk");
+        XCTAssertNil([fullReopen lookupTime:200 maximumDistance:-1]);
+        XCTAssertTrue([fm removeItemAtPath:filler error:nil]);
+        XCTAssertTrue([cache storeRaw:Raw(200, YES) requestedTime:200 actualTime:200]);
+        VLCThumbnailCache *recovered = Cache(cacheRoot, identity);
+        XCTAssertEqualObjects([recovered lookupTime:200 maximumDistance:-1][@"cache"], @"disk");
+        XCTAssertEqualObjects([recovered lookupTime:100 maximumDistance:-1][@"cache"], @"disk");
+        fprintf(stderr,
+                "ENOSPC owned_volume=%s device=%s errno=%d filler_bytes=%lu ram_fallback=1 "
+                "seed_reopen=1 disk_recovery=1\n",
+                mount.fileSystemRepresentation, device.fileSystemRepresentation, fillError,
+                (unsigned long)filled);
+    }
+    @finally
+    {
+        if (descriptor >= 0)
+            close(descriptor);
+        [fm removeItemAtPath:filler error:nil];
+        [fm removeItemAtPath:cacheRoot error:nil];
+    }
+}
+
+@end
