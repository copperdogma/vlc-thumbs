+// Foundation standardization can strip /private and recreate a /var symlink.
+// POSIX realpath preserves the canonical root required by the safe cache.
+static NSString *TestTemporaryDirectory(void)
+{
+    char *path = realpath(NSTemporaryDirectory().fileSystemRepresentation, NULL);
+    if (path == NULL)
+        return nil;
+    NSString *directory = [NSString stringWithUTF8String:path];
+    free(path);
+    return directory;
+}
