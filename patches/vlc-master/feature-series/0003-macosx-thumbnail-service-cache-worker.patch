+        [samples selectIdentity:@"other-cap-identity"];
+        Check([samples lookupTime:4000 maximumDistance:-1] == nil,
+              @"demand eviction cannot cross identity");
+        VLCThumbnailCache *aliases = Cache(root, @"aliases-cap");
+        for (int64_t i = 0; i < 2048; i++)
