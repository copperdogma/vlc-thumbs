+    });
+    Scenario(@"memory budget", ^{
+        // Use a non-directory root so 35MiB generated bytes remain RAM-only.
+        NSString *root = [parent stringByAppendingPathComponent:@"memory-only"];
+        [@"owner" writeToFile:root atomically:YES encoding:NSUTF8StringEncoding error:NULL];
+        VLCThumbnailCache *c = Cache(root, @"memory-media");
+        for (int64_t i = 0; i < 150; i++)
+            Check([c storeRaw:Raw(i, YES) requestedTime:i actualTime:i],
