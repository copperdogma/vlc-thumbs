+
+/* Different mock dimensions identify ES selection without codec fixtures. */
+struct track_context {
+    vlc_sem_t sem;
+    int status;
+    unsigned width, height, callbacks;
+};
+
+static void track_on_ended(vlc_preparser_req *req, int status,
+                           picture_t *picture, void *opaque)
+{
+    (void) req;
+    struct track_context *ctx = opaque;
+    ++ctx->callbacks;
+    ctx->status = status;
+    ctx->width = picture ? picture->format.i_visible_width : 0;
+    ctx->height = picture ? picture->format.i_visible_height : 0;
+    vlc_sem_post(&ctx->sem);
+}
+
+static void test_video_track(libvlc_instance_t *vlc, bool external)
+{
+    const struct vlc_preparser_cfg cfg = {
+        .types = VLC_PREPARSER_TYPE_THUMBNAIL,
+        .max_thumbnailer_threads = 1,
+        .timeout = VLC_TICK_FROM_MS(250),
+        .external_process = external,
+    };
+    vlc_preparser_t *preparser = vlc_preparser_New(VLC_OBJECT(vlc->p_libvlc_int), &cfg);
+    assert(preparser != NULL);
+    input_item_t *item = input_item_New(
+        "mock://video_track_count=2;video_width=32;video_height=24;"
+        "video_chroma=ARGB;length=1000000;config=video[1]{width=80,height=48}",
+        "two mock videos");
+    assert(item != NULL);
+    static const char *ids[] = { NULL, "video/0", "video/1", "video/999", "", "video/0,video/1" };
+    static const unsigned widths[] = { 32, 32, 80, 0, 0, 0 };
+    static const unsigned heights[] = { 24, 24, 48, 0, 0, 0 };
+    static const struct vlc_thumbnailer_cbs cbs = { .on_ended = track_on_ended };
+    for (size_t i = 0; i < ARRAY_SIZE(ids); ++i) {
+        struct track_context ctx = {0};
+        vlc_sem_init(&ctx.sem, 0);
+        char *id = ids[i] ? strdup(ids[i]) : NULL;
+        assert(ids[i] == NULL || id != NULL);
+        struct vlc_thumbnailer_arg arg = { .video_track_id = id };
+        vlc_preparser_req *req = vlc_preparser_req_NewThumbnail(preparser, item, &arg, &cbs, &ctx);
+        /* Construction must own the ID before Submit, including external requests. */
+        if (id) memset(id, 'x', strlen(id));
+        free(id);
+        if (i >= 4) {
+            assert(req == NULL);
+            continue;
+        }
+        assert(req != NULL);
+        assert(vlc_preparser_Submit(preparser, req) == VLC_SUCCESS);
+        assert(vlc_sem_timedwait(&ctx.sem, vlc_tick_now() + VLC_TICK_FROM_SEC(3)) == 0);
+        assert(ctx.callbacks == 1);
+        assert(ctx.width == widths[i] && ctx.height == heights[i]);
+        assert((ctx.status == VLC_SUCCESS) == (widths[i] != 0));
+        vlc_preparser_req_Release(req);
+    }
+    /* Owned strings also need cleanup when a request is never submitted. */
+    struct vlc_thumbnailer_arg arg = { .video_track_id = "video/1" };
+    struct track_context ctx = {0};
+    vlc_preparser_req *req = vlc_preparser_req_NewThumbnail(preparser, item, &arg, &cbs, &ctx);
+    assert(req != NULL);
+    vlc_preparser_req_Release(req);
+    input_item_Release(item);
+    vlc_preparser_Delete(preparser);
+}
+
+struct track_wire {
+    char *data;
+    size_t size, offset;
+};
+
+static ssize_t track_wire_write(const void *data, size_t size, void *opaque)
+{
+    struct track_wire *wire = opaque;
+    char *next = realloc(wire->data, wire->size + size + 1);
+    assert(next != NULL);
+    wire->data = next;
+    memcpy(next + wire->size, data, size);
+    wire->size += size;
+    wire->data[wire->size] = '\0';
+    return size;
+}
+
+static ssize_t track_wire_read(void *data, size_t size, void *opaque)
+{
+    struct track_wire *wire = opaque;
+    size = size < wire->size - wire->offset ? size : wire->size - wire->offset;
+    memcpy(data, wire->data + wire->offset, size);
+    wire->offset += size;
+    return size;
+}
+
+static int track_roundtrip(vlc_object_t *obj, struct vlc_preparser_msg *src,
+                           struct vlc_preparser_msg *dst, unsigned wire_mode)
+{
+    static const struct vlc_preparser_msg_serdes_cbs cbs = {
+        .write = track_wire_write, .read = track_wire_read,
+    };
+    struct vlc_preparser_msg_serdes *serdes = vlc_preparser_msg_serdes_Create(obj, &cbs, false);
+    assert(serdes != NULL);
+    struct track_wire wire = {0};
+    assert(vlc_preparser_msg_serdes_Serialize(serdes, src, &wire) == VLC_SUCCESS);
+    if (wire_mode == 1) {
+        /* Exercise a real old response, not merely an explicit JSON null. */
+        char *key = strstr(wire.data, "\"video_track_id\"");
+        assert(key != NULL);
+        char *end = strchr(key, ',');
+        char *start = key;
+        while (start > wire.data && start[-1] != ',') --start;
+        assert(start > wire.data && end != NULL);
+        --start;
+        size_t removed = end - start;
+        memmove(start, end, wire.size - (end - wire.data) + 1);
+        wire.size -= removed;
+    }
+    if (wire_mode == 2) {
+        /* Fail after decoding the owned acknowledgment, exercising cleanup. */
+        char *key = strstr(wire.data, "\"item\"");
+        assert(key != NULL);
+        char *value = strchr(key, ':') + 1;
+        while (*value == ' ') ++value;
+        assert(strncmp(value, "null", 4) == 0);
+        memcpy(value, "true", 4);
+    }
+    int ret = vlc_preparser_msg_serdes_Deserialize(serdes, dst, &wire);
+    vlc_preparser_msg_serdes_Delete(serdes);
+    free(wire.data);
+    return ret;
+}
+
+static void test_video_track_transport(libvlc_instance_t *vlc)
+{
+    vlc_object_t *obj = VLC_OBJECT(vlc->p_libvlc_int);
+    for (int type = VLC_PREPARSER_MSG_REQ_TYPE_THUMBNAIL;
+         type <= VLC_PREPARSER_MSG_REQ_TYPE_THUMBNAIL_TO_FILES; ++type) {
+        struct vlc_preparser_msg req, copy, res, reply;
+        vlc_preparser_msg_Init(&req, VLC_PREPARSER_MSG_TYPE_REQ, type);
+        req.req.uri = strdup("mock://video_track_count=2");
+        assert(req.req.uri != NULL);
+        req.req.arg.seek.type = VLC_THUMBNAILER_SEEK_TIME;
+        req.req.arg.seek.time = VLC_TICK_0;
+        req.req.arg.video_track_id = strdup("video/1");
+        assert(req.req.arg.video_track_id != NULL);
+        assert(track_roundtrip(obj, &req, &copy, false) == VLC_SUCCESS);
+        assert(copy.req.arg.video_track_id != req.req.arg.video_track_id);
+        assert(strcmp(copy.req.arg.video_track_id, "video/1") == 0);
+        vlc_preparser_msg_Clean(&copy);
+
+        vlc_preparser_msg_Init(&res, VLC_PREPARSER_MSG_TYPE_RES, type);
+        res.res.status = VLC_EGENERIC;
+        assert(track_roundtrip(obj, &res, &reply, true) == VLC_SUCCESS);
+        assert(reply.res.video_track_id == NULL);
+        assert(!vlc_preparser_msg_CheckVideoTrackId(&req, &reply));
+        vlc_preparser_msg_Clean(&reply);
+        res.res.video_track_id = strdup("video/0");
+        assert(res.res.video_track_id != NULL);
+        assert(track_roundtrip(obj, &res, &reply, false) == VLC_SUCCESS);
+        assert(!vlc_preparser_msg_CheckVideoTrackId(&req, &reply));
+        vlc_preparser_msg_Clean(&reply);
+        free(res.res.video_track_id);
+        res.res.video_track_id = strdup("video/1");
+        assert(res.res.video_track_id != NULL);
+        assert(track_roundtrip(obj, &res, &reply, false) == VLC_SUCCESS);
+        assert(vlc_preparser_msg_CheckVideoTrackId(&req, &reply));
+        vlc_preparser_msg_Clean(&reply);
+        assert(track_roundtrip(obj, &res, &reply, 2) != VLC_SUCCESS);
+        assert(reply.res.video_track_id == NULL && reply.res.item == NULL);
+        vlc_preparser_msg_Clean(&reply);
+        vlc_preparser_msg_Clean(&res);
+
+        free((char *)req.req.arg.video_track_id);
+        req.req.arg.video_track_id = NULL;
+        assert(track_roundtrip(obj, &req, &copy, true) == VLC_SUCCESS);
+        assert(copy.req.arg.video_track_id == NULL);
+        vlc_preparser_msg_Clean(&copy);
+        /* Invalid IDs allocate during decode, then must be cleaned on failure. */
+        static const char *invalid[] = { "", "video/0,video/1" };
+        for (size_t i = 0; i < ARRAY_SIZE(invalid); ++i) {
+            req.req.arg.video_track_id = strdup(invalid[i]);
+            assert(req.req.arg.video_track_id != NULL);
+            assert(track_roundtrip(obj, &req, &copy, false) != VLC_SUCCESS);
+            assert(copy.req.arg.video_track_id == NULL);
+            free((char *)req.req.arg.video_track_id);
+            req.req.arg.video_track_id = NULL;
+        }
+        vlc_preparser_msg_Clean(&req);
+    }
+}
