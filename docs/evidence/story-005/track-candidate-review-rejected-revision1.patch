+struct track_file_context {
+    vlc_sem_t sem;
+    int status;
+    bool success;
+};
+
+static void track_file_on_ended(vlc_preparser_req *req, int status,
+                                const bool *results, size_t count, void *opaque)
+{
+    (void) req;
+    struct track_file_context *ctx = opaque;
+    ctx->status = status;
+    ctx->success = count == 1 && results != NULL && results[0];
+    vlc_sem_post(&ctx->sem);
+}
+
+static void test_file_video_track(libvlc_instance_t *vlc, bool external)
+{
+    if (vlc_preparser_CheckThumbnailerFormat(VLC_THUMBNAILER_FORMAT_RGBA) != VLC_SUCCESS) {
+        fprintf(stderr, "skip: video-track file test needs RGBA encoder\n");
+        return;
+    }
+    const struct vlc_preparser_cfg cfg = {
+        .types = VLC_PREPARSER_TYPE_THUMBNAIL_TO_FILES,
+        .max_thumbnailer_threads = 1,
+        .timeout = VLC_TICK_FROM_MS(250),
+        .external_process = external,
+    };
+    vlc_preparser_t *preparser = vlc_preparser_New(VLC_OBJECT(vlc->p_libvlc_int), &cfg);
+    assert(preparser != NULL);
+    input_item_t *item = input_item_New(
+        "mock://video_track_count=2;video_width=32;video_height=24;"
+        "video_chroma=RGBA;length=1000000;config=video[1]{width=80,height=48}",
+        "two mock videos");
+    assert(item != NULL);
+    static const char *ids[] = { NULL, "video/0", "video/1", "video/999", "", "video/0,video/1" };
+    static const size_t sizes[] = { 32 * 24 * 4, 32 * 24 * 4, 80 * 48 * 4, 0, 0, 0 };
+    static const struct vlc_thumbnailer_to_files_cbs cbs = { .on_ended = track_file_on_ended };
+    for (size_t i = 0; i < ARRAY_SIZE(ids); ++i) {
+        char path[] = "/tmp/libvlc_track_XXXXXX";
+        int fd = vlc_mkstemp(path);
+        assert(fd >= 0);
+        struct vlc_thumbnailer_output out = {
+            .format = VLC_THUMBNAILER_FORMAT_RGBA,
+            .file_path = path, .creat_mode = 0600,
+        };
+        struct track_file_context ctx = {0};
+        vlc_sem_init(&ctx.sem, 0);
+        char *id = ids[i] ? strdup(ids[i]) : NULL;
+        assert(ids[i] == NULL || id != NULL);
+        struct vlc_thumbnailer_arg arg = { .video_track_id = id };
+        vlc_preparser_req *req = vlc_preparser_req_NewThumbnailToFiles(
+            preparser, item, &arg, &out, 1, &cbs, &ctx);
+        if (id) memset(id, 'x', strlen(id));
+        free(id);
+        if (i >= 4) {
+            assert(req == NULL);
+        } else {
+            assert(req != NULL);
+            assert(vlc_preparser_Submit(preparser, req) == VLC_SUCCESS);
+            assert(vlc_sem_timedwait(&ctx.sem, vlc_tick_now() + VLC_TICK_FROM_SEC(3)) == 0);
+            assert(ctx.success == (sizes[i] != 0));
+            assert((ctx.status == VLC_SUCCESS) == ctx.success);
+            vlc_preparser_req_Release(req);
+        }
+        assert(lseek(fd, 0, SEEK_END) == (off_t)sizes[i]);
+        close(fd);
+        assert(unlink(path) == 0);
+    }
+    input_item_Release(item);
+    vlc_preparser_Delete(preparser);
+}
